@page "/"
@inject LocalGameAdapter Session
@inject NavigationManager Nav
@inject BrowserStorage Storage

<PageTitle>Tak · the game of roads</PageTitle>

<div class="page home">
    @if (PendingChallenge is not null)
    {
        <div class="banner invite-banner" role="status">
            <div>
                <div class="banner-kicker">You've been invited</div>
                <div class="banner-title">@((int)PendingChallenge.BoardSize)×@((int)PendingChallenge.BoardSize) game@(PendingChallenge.HostNickname is { } n ? $" from {n}" : "")</div>
            </div>
            <div class="btn-row">
                <button type="button" class="btn btn-primary" @onclick="AcceptPendingChallenge">Accept and play</button>
                <button type="button" class="btn btn-quiet" @onclick="() => PendingChallenge = null">Not now</button>
            </div>
        </div>
    }

    @if (LinkedSuccessMessage is not null)
    {
        <div class="banner ok" role="status">
            <span>@LinkedSuccessMessage</span>
            <button type="button" class="icon-btn" aria-label="Dismiss" @onclick="() => LinkedSuccessMessage = null">✕</button>
        </div>
    }

    <section class="hero">
        <div class="hero-copy">
            <p class="hero-kicker">The beautiful game of roads</p>
            <h1 class="hero-title">Tak</h1>
            <p class="hero-lede">Stack, slide and wall your way across the board to link two opposite edges. Play the computer, a
                friend on the same screen, or anyone online. No sign-up, no game server: moves travel encrypted over Nostr and both
                devices check every one.</p>
            <div class="btn-row">
                <button type="button" class="btn btn-primary btn-lg" @onclick="StartBotGame">Play the AI</button>
                <button type="button" class="btn btn-secondary btn-lg" @onclick='() => Nav.NavigateTo("online")'>Play a friend online</button>
            </div>
        </div>
        <div class="hero-board" aria-hidden="true">
            @if (_showcase is not null)
            {
                @if (_showcase3D)
                {
                    <Board3D Scene="_showcase" Interactive="false" AutoRotate="true" Unavailable="() => _showcase3D = false" />
                }
                else
                {
                    <Board2D Scene="_showcase" />
                }
            }
        </div>
    </section>

    <section class="card setup" aria-label="New game">
        <div class="setup-head">
            <h2 class="card-title">New game</h2>
            <div class="setup-options">
                <div class="field">
                    <span class="field-label">Board</span>
                    <div class="seg size-picker" role="group" aria-label="Board size">
                        @foreach (BoardSize size in Enum.GetValues<BoardSize>())
                        {
                            <button type="button" class="seg-btn toggle-btn @(SelectedSize == size ? "active" : "")" @onclick="() => SelectedSize = size">@((int)size)×@((int)size)</button>
                        }
                    </div>
                </div>
                <label class="field">
                    <span class="field-label">Komi</span>
                    <select class="input komi-select" @bind="KomiHalves" title="Flats added to Black's count, to balance White's first move">
                        @for (int halves = 0; halves <= GameBoard.MaxKomiHalves; halves++)
                        {
                            <option value="@halves">@PtnParser.FormatKomi(halves)</option>
                        }
                    </select>
                </label>
            </div>
        </div>

        <div class="mode-grid actions-row">
            <article class="mode-card">
                <div class="mode-icon" aria-hidden="true">◆</div>
                <h3>Against the AI</h3>
                <div class="seg difficulty-picker" role="group" aria-label="AI difficulty">
                    @foreach (BotDifficulty d in Enum.GetValues<BotDifficulty>())
                    {
                        <button type="button" class="seg-btn toggle-btn @(SelectedDifficulty == d ? "active" : "")" @onclick="() => SelectedDifficulty = d">@d</button>
                    }
                </div>
                <div class="seg colour-picker" role="group" aria-label="Your colour">
                    <button type="button" class="seg-btn @(HumanColor == PlayerColor.White ? "active" : "")" @onclick="() => HumanColor = PlayerColor.White"><span class="stone-dot w"></span>White</button>
                    <button type="button" class="seg-btn @(HumanColor == PlayerColor.Black ? "active" : "")" @onclick="() => HumanColor = PlayerColor.Black"><span class="stone-dot b"></span>Black</button>
                </div>
                <button type="button" class="btn btn-primary" data-mode="ai" @onclick="StartBotGame">vs AI</button>
            </article>

            <article class="mode-card">
                <div class="mode-icon" aria-hidden="true">⇄</div>
                <h3>Pass and play</h3>
                <p class="card-text">Two players, one screen. Take turns on this device.</p>
                <button type="button" class="btn btn-primary" data-mode="local" @onclick="StartLocalGame">Local</button>
            </article>

            <article class="mode-card">
                <div class="mode-icon" aria-hidden="true">⟡</div>
                <h3>Online</h3>
                <p class="card-text">Host a game and send the link, or join with an invite. Works between phone, browser and the CLI.</p>
                <button type="button" class="btn btn-secondary" data-mode="online" @onclick='() => Nav.NavigateTo("online")'>Host or join</button>
            </article>
        </div>
    </section>

    <section class="how" id="how">
        <h2 class="section-title">How Tak works</h2>
        <div class="how-grid">
            <div class="how-item">
                <div class="how-figure place" aria-hidden="true"><span class="chip-icon flat w"></span><span class="chip-icon wall b"></span><span class="chip-icon cap w"></span></div>
                <h3>Place</h3>
                <p>On your turn, put a stone on any empty square: a flat, a wall standing on its edge, or your capstone.</p>
            </div>
            <div class="how-item">
                <div class="how-figure move" aria-hidden="true">⇢</div>
                <h3>Or move</h3>
                <p>Pick up a stack you control, carry it in a straight line and drop at least one piece on every square you pass.</p>
            </div>
            <div class="how-item">
                <div class="how-figure road" aria-hidden="true">━</div>
                <h3>Build a road</h3>
                <p>Connect two opposite edges with your flats and capstone. Walls block; only a lone capstone can flatten one.</p>
            </div>
        </div>
        <p class="how-more"><a href="rules">Read the full rules →</a></p>
    </section>
</div>

@code {
    // A mid-game position for the hero board (rank 5 first).
    private const string ShowcaseTps = "x2,2,x2/x,1,21,2S,x/1,1,12C,1,2/x,2,1,x2/2,x3,1 1 9";

    private BoardSize SelectedSize { get; set; } = BoardSize.Five;
    private BotDifficulty SelectedDifficulty { get; set; } = BotDifficulty.Medium;
    private PlayerColor HumanColor { get; set; } = PlayerColor.White;
    private int KomiHalves { get; set; }
    private string? PlayerNickname { get; set; }
    private string? LinkedSuccessMessage { get; set; }
    private InviteCode? PendingChallenge { get; set; }
    private BoardScene? _showcase;
    private bool _showcase3D = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var board = TpsSerializer.Deserialize(ShowcaseTps);
            _showcase = BoardScene.Build(board, new MoveInput(), null, []);
        }
        catch (FormatException)
        {
        }
        await CheckUrlParameters();
        PlayerNickname = await Storage.GetNicknameAsync();
    }

    private async Task CheckUrlParameters()
    {
        string query = new Uri(Nav.Uri).Query.TrimStart('?');
        if (string.IsNullOrEmpty(query))
            return;

        string? linkIdentity = null;
        string? inviteParam = null;
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kvp = part.Split('=', 2);
            if (kvp.Length != 2)
                continue;
            string key = kvp[0].ToLowerInvariant();
            string val = Uri.UnescapeDataString(kvp[1]);
            if (key == "link_identity")
                linkIdentity = val;
            else if (key is "invite" or "c" or "code")
                inviteParam = val;
        }

        if (!string.IsNullOrEmpty(linkIdentity))
        {
            try
            {
                await Storage.ImportPrivateKeyAsync(linkIdentity);
                LinkedSuccessMessage = "This device now plays with your key.";
                Nav.NavigateTo("/", replace: true);
            }
            catch (Exception e) when (e is ArgumentException or FormatException or IdentityFormatException)
            {
            }
        }

        if (!string.IsNullOrEmpty(inviteParam) && InviteCode.TryParse(inviteParam, out var invite, out _))
            PendingChallenge = invite;
    }

    private void StartBotGame()
    {
        Session.StartBotMatch(SelectedSize, SelectedDifficulty, HumanColor, PlayerNickname, KomiHalves);
        Nav.NavigateTo("play");
    }

    private void StartLocalGame()
    {
        Session.StartLocalMatch(SelectedSize, null, null, KomiHalves);
        Nav.NavigateTo("play");
    }

    private void AcceptPendingChallenge()
    {
        if (PendingChallenge is not null)
            Nav.NavigateTo($"online?invite={Uri.EscapeDataString(PendingChallenge.ToCompactCode())}");
    }
}
