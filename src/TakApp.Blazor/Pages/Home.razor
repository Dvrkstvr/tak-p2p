@page "/"
@using TakApp.Blazor.Components.Modals
@using TakApp.Blazor.Services
@using TakEngine.Core.Cryptography
@inject WebGameSessionManager Session
@inject NavigationManager Nav
@inject BrowserStorage Storage

<div class="home-container">
    
    <!-- Incoming Challenge Notification -->
    @if (PendingChallenge != null)
    {
        <div style="border: 1px solid var(--accent-amber); padding: 1.25rem 1.5rem; margin-bottom: 2rem; background: #111111; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <div>
                <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--accent-amber); font-weight: 700; letter-spacing: 0.08em; margin-bottom: 0.25rem;">
                    Match Invitation Received
                </div>
                <div style="font-size: 1.05rem; font-weight: 700; color: #ffffff; margin-bottom: 0.25rem;">
                    @((int)PendingChallenge.BoardSize)×@((int)PendingChallenge.BoardSize) Tak Challenge
                </div>
                <div style="font-size: 0.85rem; color: var(--text-secondary);">
                    From: <strong style="color: #ffffff;">@(PendingChallenge.HostNickname ?? "Anonymous")</strong>
                </div>
            </div>

            <div style="display: flex; gap: 0.75rem;">
                <button class="btn-tak btn-white" @onclick="AcceptPendingChallenge">
                    Accept & Play
                </button>
                <button class="btn-tak btn-outline" @onclick="() => PendingChallenge = null">
                    Decline
                </button>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(LinkedSuccessMessage))
    {
        <div style="border: 1px solid #ffffff; padding: 0.75rem 1rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; color: #ffffff; font-size: 0.85rem;">
            <span>✓ @LinkedSuccessMessage</span>
            <button class="btn-link-action" @onclick="() => LinkedSuccessMessage = null">✕</button>
        </div>
    }

    <!-- Hero Section -->
    <div class="hero-section">
        <h1 class="hero-title">TAK</h1>
        <div class="hero-subtitle">peer-to-peer · zero servers · encrypted</div>
        <div class="amber-line"></div>
    </div>

    <!-- Controls Row: Board Size & AI Difficulty -->
    <div class="controls-row">
        <!-- Board Size Picker -->
        <div class="control-group">
            <span class="control-label">Board size</span>
            <div class="toggle-btn-group">
                <button class="toggle-btn @(SelectedSize == BoardSize.Four ? "active" : "")"
                        @onclick="() => SelectedSize = BoardSize.Four">
                    4×4
                </button>
                <button class="toggle-btn @(SelectedSize == BoardSize.Five ? "active" : "")"
                        @onclick="() => SelectedSize = BoardSize.Five">
                    5×5
                </button>
                <button class="toggle-btn @(SelectedSize == BoardSize.Six ? "active" : "")"
                        @onclick="() => SelectedSize = BoardSize.Six">
                    6×6
                </button>
            </div>
        </div>

        <!-- AI Difficulty Picker -->
        <div class="control-group">
            <span class="control-label">AI difficulty</span>
            <div class="toggle-btn-group">
                <button class="toggle-btn @(SelectedDifficulty == BotDifficulty.Easy ? "active" : "")"
                        @onclick="() => SelectedDifficulty = BotDifficulty.Easy">
                    Easy
                </button>
                <button class="toggle-btn @(SelectedDifficulty == BotDifficulty.Medium ? "active" : "")"
                        @onclick="() => SelectedDifficulty = BotDifficulty.Medium">
                    Medium
                </button>
                <button class="toggle-btn @(SelectedDifficulty == BotDifficulty.Hard ? "active" : "")"
                        @onclick="() => SelectedDifficulty = BotDifficulty.Hard">
                    Hard
                </button>
            </div>
        </div>
    </div>

    <!-- Actions Row -->
    <div class="actions-row">
        <button class="btn-tak btn-white" @onclick="StartBotGame">
            vs AI
        </button>
        <button class="btn-tak btn-white" @onclick="StartLocalGame">
            Local
        </button>
        <button class="btn-tak btn-outline" @onclick="OpenCreateInvite">
            Invite
        </button>
        <button class="btn-tak btn-outline" @onclick="OpenJoinModal">
            Join
        </button>
    </div>

    <!-- Identity & Device Links -->
    <div style="display: flex; justify-content: center; gap: 2rem; margin-bottom: 2.5rem; font-size: 0.85rem; color: var(--text-secondary);">
        <button class="btn-link-action" @onclick="() => IsProfileModalOpen = true">
            Profile: <strong style="color: #ffffff;">@(string.IsNullOrWhiteSpace(PlayerNickname) ? "Anonymous" : PlayerNickname)</strong>
        </button>
        <button class="btn-link-action" @onclick="() => IsLinkModalOpen = true">
            Link Devices
        </button>
        <span style="font-family: var(--font-mono); color: var(--text-muted); cursor: pointer;"
              title="@FullNpub"
              @onclick="() => IsProfileModalOpen = true">
            @ShortNpub
        </span>
    </div>

    <!-- Features Architecture Block -->
    <div class="features-grid">
        <div class="feature-block">
            <div class="feature-title">LOCAL ENGINE</div>
            <div class="feature-desc">
                Deterministic rules, carry limits, and DFS road detection run locally inside your browser via WebAssembly.
            </div>
        </div>

        <div class="feature-block">
            <div class="feature-title">NOSTR RELAY</div>
            <div class="feature-desc">
                Peer-to-peer encrypted store-and-forward messaging across public Nostr WebSocket relays with zero centralized servers.
            </div>
        </div>

        <div class="feature-block">
            <div class="feature-title">MULTI-DEVICE</div>
            <div class="feature-desc">
                Universal identity allows pairing phones, tablets, and desktops using sovereign cryptographic keypairs.
            </div>
        </div>
    </div>

</div>

<!-- Modals -->
<InviteModal IsOpen="@IsInviteModalOpen"
             IsGenerateMode="@IsInviteGenerateMode"
             Title="@InviteModalTitle"
             InviteCode="@GeneratedInviteCode"
             OnClose="() => IsInviteModalOpen = false"
             OnJoinCodeSubmitted="HandleJoinCode" />

<LinkDeviceModal IsOpen="@IsLinkModalOpen"
                 OnClose="() => IsLinkModalOpen = false"
                 OnIdentityChanged="RefreshIdentity" />

<ProfileModal IsOpen="@IsProfileModalOpen"
              OnClose="() => IsProfileModalOpen = false"
              OnProfileSaved="RefreshIdentity" />

@code {
    private BoardSize SelectedSize { get; set; } = BoardSize.Five;
    private BotDifficulty SelectedDifficulty { get; set; } = BotDifficulty.Medium;
    private bool IsInviteModalOpen { get; set; }
    private bool IsInviteGenerateMode { get; set; } = true;
    private string InviteModalTitle { get; set; } = "Direct Invite";
    private string GeneratedInviteCode { get; set; } = "";

    private bool IsLinkModalOpen { get; set; } = false;
    private bool IsProfileModalOpen { get; set; } = false;
    private string? PlayerNickname { get; set; }
    private string ShortNpub { get; set; } = "Loading...";
    private string FullNpub { get; set; } = "";
    private string? LinkedSuccessMessage { get; set; }
    private InviteCode? PendingChallenge { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await CheckUrlParameters();
        await RefreshIdentity();
    }

    private async Task CheckUrlParameters()
    {
        var uri = new Uri(Nav.Uri);
        string query = uri.Query.TrimStart('?');

        if (string.IsNullOrEmpty(query)) return;

        string? linkIdentity = null;
        string? inviteParam = null;

        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kvp = part.Split('=');
            if (kvp.Length == 2)
            {
                string key = kvp[0].ToLowerInvariant();
                string val = Uri.UnescapeDataString(kvp[1]);

                if (key == "link_identity")
                    linkIdentity = val;
                else if (key is "invite" or "c" or "code")
                    inviteParam = val;
            }
        }

        // 1. Device Pairing URL check
        if (!string.IsNullOrEmpty(linkIdentity))
        {
            try
            {
                await Storage.ImportPrivateKeyAsync(linkIdentity);
                LinkedSuccessMessage = "Device linked successfully to your Nostr identity! Ready for cross-device play.";
                Nav.NavigateTo("/", replace: true);
            }
            catch { }
        }

        // 2. Direct Challenge Invite URL check
        if (!string.IsNullOrEmpty(inviteParam))
        {
            try
            {
                PendingChallenge = InviteCode.Parse(inviteParam);
            }
            catch { }
        }
    }

    private async Task RefreshIdentity()
    {
        var (_, pubHex) = await Storage.GetOrCreateKeypairAsync();
        PlayerNickname = await Storage.GetNicknameAsync();
        try
        {
            FullNpub = Nip19.ToNpub(pubHex);
            ShortNpub = FullNpub.Length > 18 ? $"{FullNpub[..10]}...{FullNpub[^6..]}" : FullNpub;
        }
        catch
        {
            FullNpub = pubHex;
            ShortNpub = pubHex.Length > 12 ? $"{pubHex[..8]}...{pubHex[^4..]}" : pubHex;
        }
        StateHasChanged();
    }

    private void StartBotGame()
    {
        Session.StartBotMatch(SelectedSize, SelectedDifficulty, PlayerColor.White, PlayerNickname);
        Nav.NavigateTo("play");
    }

    private void StartLocalGame()
    {
        Session.StartLocalMatch(SelectedSize, PlayerNickname, "Opponent");
        Nav.NavigateTo("play");
    }

    private async Task OpenCreateInvite()
    {
        var (priv, pub) = await Storage.GetOrCreateKeypairAsync();
        var invite = new InviteCode(
            GameId: Guid.NewGuid(),
            HostPubKey: pub,
            BoardSize: SelectedSize,
            Relays: new[] { "wss://relay.damus.io", "wss://nos.lol" },
            HostNickname: PlayerNickname);

        GeneratedInviteCode = invite.ToCompactCode();
        InviteModalTitle = $"Invite for {(int)SelectedSize}×{(int)SelectedSize} Match";
        IsInviteGenerateMode = true;
        IsInviteModalOpen = true;
    }

    private void OpenJoinModal()
    {
        InviteModalTitle = "Join Tak Match";
        IsInviteGenerateMode = false;
        IsInviteModalOpen = true;
    }

    private void HandleJoinCode(string code)
    {
        try
        {
            var payload = InviteCode.Parse(code);
            Session.StartLocalMatch(payload.BoardSize, payload.HostNickname ?? "Host", PlayerNickname ?? "You");
            Nav.NavigateTo("play");
        }
        catch { }
    }

    private void AcceptPendingChallenge()
    {
        if (PendingChallenge != null)
        {
            Session.StartLocalMatch(PendingChallenge.BoardSize, PendingChallenge.HostNickname ?? "Host", PlayerNickname ?? "You");
            Nav.NavigateTo("play");
        }
    }
}
