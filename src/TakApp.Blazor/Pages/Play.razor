@page "/play"
@using TakEngine.Abstractions
@using TakEngine.Core.Board
@using TakEngine.Core.Rules
@inject WebGameSessionManager Session
@inject NavigationManager Nav
@inject BrowserStorage Storage
@implements IDisposable

<div class="game-play-container" @onkeydown="HandleKeyDown" tabindex="0" @ref="ContainerRef">

<!-- DESKTOP ARENA LAYOUT (>= 1024px) -->
<div class="arena-3col">
    
    <!-- Left Column: Players & Game Status -->
    <div class="arena-col arena-col-left">
        <div>
            <div class="section-muted-header">PLAYERS</div>
            
            <PieceInventoryView Board="@Session.Board"
                                Color="PlayerColor.White"
                                PlayerName="@Session.WhitePlayerName"
                                SelectedPieceType="@SelectedPieceType"
                                OnPieceSelected="HandlePieceSelected" />

            <PieceInventoryView Board="@Session.Board"
                                Color="PlayerColor.Black"
                                PlayerName="@Session.BlackPlayerName"
                                SelectedPieceType="@SelectedPieceType"
                                OnPieceSelected="HandlePieceSelected" />

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div style="border: 1px solid #7f1d1d; color: #f87171; padding: 0.6rem; font-size: 0.8rem; margin-top: 1rem;">
                    @ErrorMessage
                </div>
            }
        </div>

        <div class="status-block">
            <div class="section-muted-header">STATUS</div>
            <div class="status-text">
                @((int)Session.CurrentSize)×@((int)Session.CurrentSize) · Turn @(Session.Board?.TurnNumber ?? 1) · @GetModeDescription()
            </div>
            @if (Session.IsBotThinking)
            {
                <div style="color: var(--accent-amber); font-size: 0.8rem; margin-bottom: 0.5rem; font-weight: 600;">
                    AI is thinking...
                </div>
            }
            <div class="status-sha">
                SHA: #@(Session.PrevStateHash?.Length > 16 ? Session.PrevStateHash[..16] : (Session.PrevStateHash ?? "GENESIS"))...
            </div>

            <button class="btn-tak btn-outline btn-sm" style="width: 100%; margin-top: 0.8rem;" @onclick="() => ShowControlsModal = true">
                ⌨ Controls Guide
            </button>
        </div>
    </div>

    <!-- Center Column: Status Bar, 2.5D Board, Piece Selector -->
    <div class="arena-col arena-col-center">
        <!-- Status Bar -->
        <GameStatusHeader Board="@Session.Board"
                          WhitePlayerName="@Session.WhitePlayerName"
                          BlackPlayerName="@Session.BlackPlayerName"
                          Is25D="@Is25D"
                          OnResignRequested="HandleResign"
                          OnNewGameRequested="HandleLeave"
                          OnTogglePerspective="TogglePerspective" />

        <!-- 2.5D Board -->
        <TakBoardView Board="@Session.Board"
                      SelectedCoord="@SelectedCoord"
                      LastMoveTarget="@LastMoveTarget"
                      LegalTargets="@LegalPlacementTargets"
                      LegalSlideTargets="@LegalSlideTargets"
                      InspectingCoord="@InspectingCoord"
                      WinningRoad="@Session.WinningRoadCoords"
                      Is25D="@Is25D"
                      OnSquareClick="HandleSquareClick"
                      OnSquareRightClick="HandleSquareRightClick"
                      OnDismissInspect="HandleDismissInspect" />

        <!-- Piece Selector (Flat | Wall | Cap) with PlayTak hotkeys -->
        <div class="piece-selector-row">
            <button class="piece-selector-tab @(SelectedPieceType == PieceType.Flat ? "active" : "")"
                    @onclick="() => HandlePieceSelected(PieceType.Flat)">
                Flat <span class="kbd-hint">F</span>
            </button>
            <button class="piece-selector-tab @(SelectedPieceType == PieceType.Standing ? "active" : "")"
                    @onclick="() => HandlePieceSelected(PieceType.Standing)">
                Wall <span class="kbd-hint">W</span>
            </button>
            @if (Session.Board?.Size != BoardSize.Four)
            {
                <button class="piece-selector-tab @(SelectedPieceType == PieceType.Capstone ? "active" : "")"
                        @onclick="() => HandlePieceSelected(PieceType.Capstone)">
                    Cap <span class="kbd-hint">C</span>
                </button>
            }
        </div>

        <!-- Stack Slide Bar (Active when an owned stack is clicked) -->
        <StackSlideBar OriginCoord="@SlideOriginCoord"
                       Board="@Session.Board"
                       ActiveDirection="@ActiveSlideDirection"
                       OnSlideConfirmed="HandleSlideConfirmed"
                       OnCancelRequested="HandleSlideCancelled" />
    </div>

    <!-- Right Column: Move History (PTN) -->
    <div class="arena-col arena-col-right">
        <MoveHistoryPanel Moves="@Session.MoveHistoryPtn" />
    </div>

</div>

<!-- MOBILE PLAY VIEW (< 1024px) -->
<div class="mobile-play-wrapper">
    <!-- Status Bar -->
    <GameStatusHeader Board="@Session.Board"
                      WhitePlayerName="@Session.WhitePlayerName"
                      BlackPlayerName="@Session.BlackPlayerName"
                      Is25D="@Is25D"
                      OnResignRequested="HandleResign"
                      OnNewGameRequested="HandleLeave"
                      OnTogglePerspective="TogglePerspective" />

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div style="border: 1px solid #7f1d1d; color: #f87171; padding: 0.5rem; font-size: 0.8rem; margin-bottom: 0.75rem; width: 100%; max-width: 480px;">
            @ErrorMessage
        </div>
    }

    <!-- 2.5D Board -->
    <TakBoardView Board="@Session.Board"
                  SelectedCoord="@SelectedCoord"
                  LastMoveTarget="@LastMoveTarget"
                  LegalTargets="@LegalPlacementTargets"
                  LegalSlideTargets="@LegalSlideTargets"
                  InspectingCoord="@InspectingCoord"
                  WinningRoad="@Session.WinningRoadCoords"
                  Is25D="@Is25D"
                  OnSquareClick="HandleSquareClick"
                  OnSquareRightClick="HandleSquareRightClick"
                  OnDismissInspect="HandleDismissInspect" />

    <!-- Piece Selector (Flat | Wall | Cap) -->
    <div class="piece-selector-row">
        <button class="piece-selector-tab @(SelectedPieceType == PieceType.Flat ? "active" : "")"
                @onclick="() => HandlePieceSelected(PieceType.Flat)">
            Flat <span class="kbd-hint">F</span>
        </button>
        <button class="piece-selector-tab @(SelectedPieceType == PieceType.Standing ? "active" : "")"
                @onclick="() => HandlePieceSelected(PieceType.Standing)">
            Wall <span class="kbd-hint">W</span>
        </button>
        @if (Session.Board?.Size != BoardSize.Four)
        {
            <button class="piece-selector-tab @(SelectedPieceType == PieceType.Capstone ? "active" : "")"
                    @onclick="() => HandlePieceSelected(PieceType.Capstone)">
                Cap <span class="kbd-hint">C</span>
            </button>
        }
    </div>

    <!-- Mobile Single-Line Inventory -->
    @if (Session.Board != null)
    {
        var wRes = Session.Board.WhiteReserves;
        var bRes = Session.Board.BlackReserves;
        <div class="mobile-inventory-line">
            <span><span class="player-dot-white"></span> White F:@wRes.Stones W:@wRes.Stones C:@wRes.Capstones</span>
            <span><span class="player-dot-black"></span> Black F:@bRes.Stones W:@bRes.Stones C:@bRes.Capstones</span>
        </div>
    }

    <!-- Stack Slide Bar -->
    <StackSlideBar OriginCoord="@SlideOriginCoord"
                   Board="@Session.Board"
                   ActiveDirection="@ActiveSlideDirection"
                   OnSlideConfirmed="HandleSlideConfirmed"
                   OnCancelRequested="HandleSlideCancelled" />

    <!-- Collapsible Move History -->
    <div class="mobile-moves-toggle">
        <button class="mobile-moves-btn" @onclick="() => IsMobileMovesExpanded = !IsMobileMovesExpanded">
            <span>MOVES @(IsMobileMovesExpanded ? "▲" : "▼")</span>
            <span style="color: var(--text-muted); font-size: 0.75rem;">(@Session.MoveHistoryPtn.Count moves)</span>
        </button>
        @if (IsMobileMovesExpanded)
        {
            <div class="mobile-moves-content">
                <MoveHistoryPanel Moves="@Session.MoveHistoryPtn" />
            </div>
        }
    </div>
</div>

<!-- PlayTak Controls Help Modal -->
@if (ShowControlsModal)
{
    <div class="modal-backdrop-custom" @onclick="() => ShowControlsModal = false">
        <div class="modal-card-custom" @onclick:stopPropagation="true">
            <div class="modal-header-custom">
                <h3 style="margin: 0; font-size: 1.1rem; color: #ffffff;">PlayTak Controls Guide</h3>
                <button class="btn-tak btn-ghost btn-sm" @onclick="() => ShowControlsModal = false">✕</button>
            </div>
            <div class="controls-guide-body">
                <div class="controls-guide-row">
                    <span class="controls-guide-key">Left Click (Empty)</span>
                    <span class="controls-guide-desc">Place active piece (Flat, Wall, or Capstone)</span>
                </div>
                <div class="controls-guide-row">
                    <span class="controls-guide-key">Right Click (Empty)</span>
                    <span class="controls-guide-desc">Quick-place Standing Stone (Wall)</span>
                </div>
                <div class="controls-guide-row">
                    <span class="controls-guide-key">Left Click (Stack)</span>
                    <span class="controls-guide-desc">Pick up stack to slide; click adjacent target to move</span>
                </div>
                <div class="controls-guide-row">
                    <span class="controls-guide-key">Right Click (Stack)</span>
                    <span class="controls-guide-desc">Inspect all layers of the stack from top to bottom</span>
                </div>
                <div class="controls-guide-row">
                    <span class="controls-guide-key">Reserve Pieces</span>
                    <span class="controls-guide-desc">Click Flat to select; click again or right-click to rotate to Wall</span>
                </div>
                <div class="controls-guide-row">
                    <span class="controls-guide-key">[F] / [W] / [C]</span>
                    <span class="controls-guide-desc">Hotkeys: Select Flat, Wall, or Capstone</span>
                </div>
                <div class="controls-guide-row">
                    <span class="controls-guide-key">[Esc]</span>
                    <span class="controls-guide-desc">Cancel piece selection or stack movement</span>
                </div>
            </div>
        </div>
    </div>
}

</div>

@code {
    private ElementReference ContainerRef;
    private Coord? SelectedCoord { get; set; }
    private Coord? SlideOriginCoord { get; set; }
    private Coord? LastMoveTarget { get; set; }
    private Coord? InspectingCoord { get; set; }
    private Direction? ActiveSlideDirection { get; set; }
    private PieceType? SelectedPieceType { get; set; } = PieceType.Flat;
    private HashSet<Coord> LegalPlacementTargets { get; set; } = new();
    private HashSet<Coord> LegalSlideTargets { get; set; } = new();
    private List<SlideMove> CurrentLegalSlideMoves { get; set; } = new();
    private string? ErrorMessage { get; set; }
    private bool Is25D { get; set; } = true;
    private bool IsMobileMovesExpanded { get; set; } = false;
    private bool ShowControlsModal { get; set; } = false;

    protected override void OnInitialized()
    {
        if (Session.Board == null)
        {
            Session.StartLocalMatch(BoardSize.Five);
        }

        Session.OnStateChanged += HandleSessionChanged;
        RefreshLegalTargets();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await ContainerRef.FocusAsync();
            }
            catch { }
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key.Equals("f", StringComparison.OrdinalIgnoreCase))
        {
            HandlePieceSelected(PieceType.Flat);
        }
        else if (e.Key.Equals("w", StringComparison.OrdinalIgnoreCase))
        {
            HandlePieceSelected(PieceType.Standing);
        }
        else if (e.Key.Equals("c", StringComparison.OrdinalIgnoreCase))
        {
            if (Session.Board?.Size != BoardSize.Four)
            {
                HandlePieceSelected(PieceType.Capstone);
            }
        }
        else if (e.Key == "Escape")
        {
            SlideOriginCoord = null;
            SelectedCoord = null;
            InspectingCoord = null;
            ActiveSlideDirection = null;
            ShowControlsModal = false;
            RefreshLegalTargets();
        }
        else if (e.Key == "?" || e.Key.Equals("h", StringComparison.OrdinalIgnoreCase))
        {
            ShowControlsModal = !ShowControlsModal;
        }
    }

    private void TogglePerspective()
    {
        Is25D = !Is25D;
    }

    private string GetModeDescription()
    {
        if (Session.IsBotMatch) return $"AI {Session.BotDifficulty}";
        if (Session.IsLocalOnly) return "Local Pass & Play";
        return "Nostr Remote";
    }

    private void HandleSessionChanged()
    {
        RefreshLegalTargets();
        InvokeAsync(StateHasChanged);
    }

    private void HandlePieceSelected(PieceType type)
    {
        SelectedPieceType = type;
        SlideOriginCoord = null;
        ActiveSlideDirection = null;
        InspectingCoord = null;
        RefreshLegalTargets();
    }

    private void HandleSquareClick(Coord coord)
    {
        ErrorMessage = null;
        if (InspectingCoord.HasValue)
        {
            InspectingCoord = null;
        }

        if (Session.Board == null || Session.IsBotThinking) return;

        // If currently in slide mode
        if (SlideOriginCoord.HasValue)
        {
            var origin = SlideOriginCoord.Value;

            // Clicking origin again cancels slide
            if (coord == origin)
            {
                SlideOriginCoord = null;
                SelectedCoord = null;
                ActiveSlideDirection = null;
                RefreshLegalTargets();
                return;
            }

            // If clicked square is a legal slide destination
            if (LegalSlideTargets.Contains(coord))
            {
                TryExecuteSlideToTarget(coord);
                return;
            }

            // Clicking another owned stack switches slide origin
            var clickedStack = Session.Board.GetStack(coord);
            if (!clickedStack.IsEmpty && Session.Board.Phase == GamePhase.Playing && clickedStack.Owner == Session.Board.ActivePlayer)
            {
                SlideOriginCoord = coord;
                SelectedCoord = coord;
                ActiveSlideDirection = null;
                RefreshLegalTargets();
                return;
            }

            // Clicked an unrelated square: cancel slide and if empty, proceed to placement
            SlideOriginCoord = null;
            SelectedCoord = null;
            ActiveSlideDirection = null;
            RefreshLegalTargets();
        }

        var targetStack = Session.Board.GetStack(coord);

        // Case A: Square is empty -> place active piece
        if (targetStack.IsEmpty)
        {
            SlideOriginCoord = null;
            ActiveSlideDirection = null;
            SelectedCoord = coord;

            PieceType pieceToPlace = SelectedPieceType ?? PieceType.Flat;
            var move = new PlaceMove(coord, pieceToPlace);
            var result = Session.ExecuteMove(move);

            if (!result.IsSuccess)
            {
                ErrorMessage = result.ErrorMessage;
            }
            else
            {
                LastMoveTarget = coord;
                SelectedCoord = null;
            }
        }
        // Case B: Square is occupied
        else
        {
            if (Session.Board.Phase == GamePhase.Playing && targetStack.Owner == Session.Board.ActivePlayer)
            {
                SelectedCoord = coord;
                SlideOriginCoord = coord;
                ActiveSlideDirection = null;
            }
            else
            {
                SlideOriginCoord = null;
                SelectedCoord = coord;
                InspectingCoord = coord;
            }
        }

        RefreshLegalTargets();
    }

    private void TryExecuteSlideToTarget(Coord targetCoord)
    {
        if (!SlideOriginCoord.HasValue || Session.Board == null) return;
        var origin = SlideOriginCoord.Value;

        int dx = targetCoord.X - origin.X;
        int dy = targetCoord.Y - origin.Y;

        Direction? dir = null;
        if (dx == 0 && dy > 0) dir = Direction.North;
        else if (dx == 0 && dy < 0) dir = Direction.South;
        else if (dx > 0 && dy == 0) dir = Direction.East;
        else if (dx < 0 && dy == 0) dir = Direction.West;

        if (!dir.HasValue) return;

        ActiveSlideDirection = dir;
        int stepDist = Math.Max(Math.Abs(dx), Math.Abs(dy));
        var matchingMoves = CurrentLegalSlideMoves.Where(m => m.Direction == dir.Value && m.Drops.Count == stepDist).ToList();

        if (matchingMoves.Count == 1)
        {
            HandleSlideConfirmed(matchingMoves[0]);
        }
        else if (matchingMoves.Count > 1)
        {
            // Pick maximum lift move for direct click
            var maxLiftMove = matchingMoves.OrderByDescending(m => m.LiftCount).First();
            HandleSlideConfirmed(maxLiftMove);
        }
    }

    private void HandleSquareRightClick(Coord coord)
    {
        ErrorMessage = null;
        if (Session.Board == null || Session.IsBotThinking) return;

        // If in slide mode, right-click cancels it
        if (SlideOriginCoord.HasValue)
        {
            SlideOriginCoord = null;
            SelectedCoord = null;
            ActiveSlideDirection = null;
            RefreshLegalTargets();
            return;
        }

        // If inspecting, right click dismisses it
        if (InspectingCoord.HasValue)
        {
            InspectingCoord = null;
            RefreshLegalTargets();
            return;
        }

        var stack = Session.Board.GetStack(coord);
        if (stack.IsEmpty)
        {
            // PlayTak Quick-Wall Placement:
            var move = new PlaceMove(coord, PieceType.Standing);
            var result = Session.ExecuteMove(move);
            if (!result.IsSuccess)
            {
                ErrorMessage = result.ErrorMessage;
            }
            else
            {
                LastMoveTarget = coord;
                SelectedCoord = null;
            }
        }
        else
        {
            // PlayTak Stack Inspection:
            InspectingCoord = coord;
        }

        RefreshLegalTargets();
    }

    private void HandleDismissInspect()
    {
        InspectingCoord = null;
    }

    private void HandleSlideConfirmed(SlideMove move)
    {
        ErrorMessage = null;
        var res = Session.ExecuteMove(move);
        if (!res.IsSuccess)
        {
            ErrorMessage = res.ErrorMessage;
        }
        else
        {
            (int dx, int dy) = move.Direction switch
            {
                Direction.North => (0, 1),
                Direction.South => (0, -1),
                Direction.East => (1, 0),
                Direction.West => (-1, 0),
                _ => (0, 0)
            };
            LastMoveTarget = new Coord(move.Origin.X + dx * move.Drops.Count, move.Origin.Y + dy * move.Drops.Count);
            SlideOriginCoord = null;
            SelectedCoord = null;
            ActiveSlideDirection = null;
        }

        RefreshLegalTargets();
    }

    private void HandleSlideCancelled()
    {
        SlideOriginCoord = null;
        SelectedCoord = null;
        ActiveSlideDirection = null;
        RefreshLegalTargets();
    }

    private void HandleResign()
    {
        if (Session.Board != null)
        {
            Session.Resign(Session.Board.ActivePlayer);
        }
    }

    private void HandleLeave()
    {
        Nav.NavigateTo("");
    }

    private void RefreshLegalTargets()
    {
        LegalPlacementTargets.Clear();
        LegalSlideTargets.Clear();
        CurrentLegalSlideMoves.Clear();

        if (Session.Board == null || Session.Board.Phase == GamePhase.Completed) return;

        if (SlideOriginCoord.HasValue)
        {
            var moves = MoveValidator.GetLegalMovesForSquare(Session.Board, SlideOriginCoord.Value);
            CurrentLegalSlideMoves = moves.OfType<SlideMove>().ToList();

            foreach (var sm in CurrentLegalSlideMoves)
            {
                (int dx, int dy) = sm.Direction switch
                {
                    Direction.North => (0, 1),
                    Direction.South => (0, -1),
                    Direction.East => (1, 0),
                    Direction.West => (-1, 0),
                    _ => (0, 0)
                };

                for (int k = 1; k <= sm.Drops.Count; k++)
                {
                    LegalSlideTargets.Add(new Coord(sm.Origin.X + dx * k, sm.Origin.Y + dy * k));
                }
            }
        }
        else
        {
            int size = (int)Session.Board.Size;
            for (int x = 0; x < size; x++)
            {
                for (int y = 0; y < size; y++)
                {
                    var c = new Coord(x, y);
                    if (Session.Board.GetStack(c).IsEmpty)
                    {
                        LegalPlacementTargets.Add(c);
                    }
                }
            }
        }
    }

    public void Dispose()
    {
        Session.OnStateChanged -= HandleSessionChanged;
    }
}
