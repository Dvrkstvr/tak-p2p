@page "/play"
@using TakEngine.Abstractions
@inject LocalGameAdapter Session
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>@(Session.IsBotMatch ? "Tak vs AI" : "Tak · pass and play")</PageTitle>

@if (Session.Board is { } board)
{
    <GameTable Board="board"
               CanAct="!Session.IsBotThinking"
               LegalMoves="Session.LegalMovesFor"
               Submit="SubmitAsync"
               WhiteName="@Session.WhitePlayerName"
               BlackName="@Session.BlackPlayerName"
               MyColor="@(Session.IsBotMatch ? Session.LocalPlayerColor : (PlayerColor?)null)"
               Moves="Session.MoveHistoryPtn"
               StateHash="@Session.StateHash"
               ModeLabel="@ModeLabel"
               Activity="@(Session.IsBotThinking ? "AI is thinking…" : null)"
               Resign="ResignAsync"
               Leave="Leave"
               Rematch="Rematch" />
}

@code {
    private string ModeLabel => Session.IsBotMatch ? $"vs AI {Session.BotDifficulty}" : "Pass and play";

    protected override void OnInitialized()
    {
        if (Session.Board is null)
            Session.StartLocalMatch(BoardSize.Five);
        Session.OnStateChanged += Changed;
    }

    private void Changed() => _ = InvokeAsync(StateHasChanged);

    private Task<CommandResult> SubmitAsync(TakMove move) => Task.FromResult(Session.ExecuteMove(move));

    private Task ResignAsync()
    {
        // Pass-and-play semantics: the side to move resigns, so never while the AI is about to move.
        if (!Session.IsBotThinking)
            Session.Resign();
        return Task.CompletedTask;
    }

    private void Leave() => Nav.NavigateTo("");

    private void Rematch() => Session.Restart();

    public void Dispose() => Session.OnStateChanged -= Changed;
}
