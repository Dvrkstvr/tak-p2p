@page "/online"
@using TakEngine.Multiplayer
@using TakEngine.Transport.Relay
@inject OnlineGameService Online
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

@* D-046: play over nos.lol + damus in the browser. A view over OnlineGameService; the game itself verifies everything. *@
<PageTitle>Tak · online</PageTitle>

@if (Online.Game is not { } game)
{
    <div class="page lobby">
        <header class="page-head">
            <a class="back-link" href="">← Home</a>
            <h1>Play online</h1>
            <p class="lede">No account and no game server: your moves travel encrypted over public Nostr relays
                (nos.lol and relay.damus.io), and both devices check every move.</p>
        </header>

        @if (Error is not null)
        {
            <div class="online-error" role="alert">@Error</div>
        }

        <div class="lobby-grid">
            <section class="card">
                <h2 class="card-title">Host a game</h2>
                <p class="card-text">Pick the board, then send the invite to your friend.</p>
                <div class="field">
                    <span class="field-label">Board size</span>
                    <div class="seg size-picker" role="group" aria-label="Board size">
                        @foreach (BoardSize size in Enum.GetValues<BoardSize>())
                        {
                            <button type="button" class="seg-btn @(HostSize == size ? "active" : "")" @onclick="() => HostSize = size">@((int)size)×@((int)size)</button>
                        }
                    </div>
                </div>
                <label class="field">
                    <span class="field-label">Komi <span class="muted">(flats added to Black's count)</span></span>
                    <select class="online-komi input" @bind="HostKomiHalves">
                        @for (int halves = 0; halves <= GameBoard.MaxKomiHalves; halves++)
                        {
                            <option value="@halves">@PtnParser.FormatKomi(halves)</option>
                        }
                    </select>
                </label>
                <button type="button" class="btn btn-primary" disabled="@Busy" @onclick="HostAsync">Host a game</button>
                <p class="card-note">Colours are drawn fairly from both players' secrets once your friend joins.</p>
            </section>

            <section class="card">
                <h2 class="card-title">Join a game</h2>
                <p class="card-text">Opened an invite link? It's already pasted below.</p>
                <textarea class="online-invite-input input" rows="4" placeholder="Paste an invite (TAK2_…)" @bind="InviteText"></textarea>
                <div class="btn-row">
                    <button type="button" class="btn btn-primary" disabled="@Busy" @onclick="JoinAsync">Join</button>
                    <button type="button" class="btn btn-quiet" disabled="@Busy" @onclick="RebuildAsync"
                            title="For a game this browser already joined or hosted, after a reload">Rebuild from relays</button>
                </div>
                <p class="card-note">Reloaded mid-game? Paste the same invite and use <em>Rebuild from relays</em>.</p>
            </section>
        </div>

        @if (Busy)
        {
            <div class="lobby-busy"><span class="spinner"></span> Talking to the relays…</div>
        }

        @if (Stored.Count > 0)
        {
            <section class="card online-stored">
                <h2 class="card-title">This tab's games</h2>
                <p class="card-text">Games you left in this tab. A reload forgets them; then use Rebuild from relays.</p>
                <ul class="stored-list">
                    @foreach (NetGameRecord record in Stored)
                    {
                        <li>
                            <span>@record.Role · @((int)record.Size)×@((int)record.Size) · @StoredState(record) · <code>@record.GameId.ToString("N")[..8]</code></span>
                            <button type="button" class="btn btn-quiet btn-sm" disabled="@Busy" @onclick="() => ResumeAsync(record.GameId)">Resume</button>
                        </li>
                    }
                </ul>
            </section>
        }
    </div>
}
else if (game.Result is null && game.Record.State is HandshakeState.Inviting or HandshakeState.Joining)
{
    <div class="page waiting-room">
        <header class="page-head">
            <h1>@(game.Record.State == HandshakeState.Inviting ? "Invite your opponent" : "Joining…")</h1>
            <p class="lede online-waiting">Waiting @Online.Waiting</p>
        </header>

        @if (game.Record.State == HandshakeState.Inviting && Online.InviteCode is { } invite)
        {
            <section class="card invite-card">
                <div class="invite-qr" aria-label="QR code of the invite link">@((MarkupString)QrCodeSvgHelper.GenerateSvg(InviteLink(invite), "#14110f", 2))</div>
                <div class="invite-body">
                    <p class="card-text">Send this link to the other player. They can also scan the code, paste the invite into <em>Join</em>,
                        or run <code>join</code> in the CLI. The game starts as soon as they join.</p>
                    <div class="copy-field">
                        <input class="input" readonly value="@InviteLink(invite)" aria-label="Invite link" />
                        <button type="button" class="btn btn-primary btn-sm" @onclick="() => CopyAsync(InviteLink(invite), Copied.Link)">@(_copied == Copied.Link ? "Copied ✓" : "Copy link")</button>
                    </div>
                    <details class="invite-code">
                        <summary>Show the invite code</summary>
                        <textarea class="online-invite-input input" rows="4" readonly>@invite</textarea>
                        <button type="button" class="btn btn-quiet btn-sm" @onclick="() => CopyAsync(invite, Copied.Code)">@(_copied == Copied.Code ? "Copied ✓" : "Copy code")</button>
                    </details>
                </div>
            </section>
        }

        @Connection(game)
        <div class="btn-row">
            <button type="button" class="btn btn-quiet" @onclick="LeaveAsync">Leave</button>
        </div>
        @Transcript()
    </div>
}
else if (Online.Board is { } board)
{
    <GameTable Board="board"
               Result="game.Result"
               CanAct="@(Online.IsMyTurn && game.Record.State == HandshakeState.InGame)"
               LegalMoves="c => MoveValidator.GetLegalMovesForSquare(board, c)"
               Submit="SubmitAsync"
               WhiteName="@NameFor(game, PlayerColor.White)"
               BlackName="@NameFor(game, PlayerColor.Black)"
               MyColor="game.MyColor"
               Moves="Online.Moves"
               StateHash="@game.StateHash"
               ModeLabel="Online"
               Activity="@(game.Result is null && !Online.IsMyTurn ? $"Waiting {Online.Waiting}" : null)"
               Resign="ResignAsync"
               Leave="LeaveAsync">
        <SidePanel>
            @if (game.Result is null)
            {
                <p class="online-waiting muted">@Online.Waiting</p>
            }
            @if (game.Result is { } result)
            {
                <div class="online-final">FINAL @OnlineGameService.Result(result) <span class="online-hash">@game.StateHash</span></div>
            }
            @if (Error is not null)
            {
                <div class="online-error" role="alert">@Error</div>
            }
            @Connection(game)
            @if (game.Result is null)
            {
                <details class="panel">
                    <summary class="panel-title">Type a move (PTN)</summary>
                    <div class="ptn-row">
                        <input class="online-ptn-input input" placeholder="a1, Sb2, 3c3>12" @bind="PtnText" @bind:event="oninput" @onkeydown="HandlePtnKey" />
                        <button type="button" class="btn btn-primary btn-sm" disabled="@(!Online.IsMyTurn)" @onclick="SendPtnAsync">Send</button>
                    </div>
                </details>
            }
            @Transcript()
        </SidePanel>
    </GameTable>
}

@code {
    private enum Copied { None, Link, Code, Transcript }

    private BoardSize HostSize { get; set; } = BoardSize.Five;
    private int HostKomiHalves { get; set; }
    private string InviteText { get; set; } = "";
    private string PtnText { get; set; } = "";
    private string? Error { get; set; }
    private bool Busy { get; set; }
    private IReadOnlyList<NetGameRecord> Stored { get; set; } = [];
    private Copied _copied;

    protected override async Task OnInitializedAsync()
    {
        Stored = await Online.StoredGamesAsync();
        Online.Changed += Refresh;
        var query = new Uri(Nav.Uri).Query.TrimStart('?');
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = part.Split('=', 2);
            if (kv.Length == 2 && kv[0].ToLowerInvariant() is "invite" or "c" or "code")
                InviteText = Uri.UnescapeDataString(kv[1]);
        }
    }

    private RenderFragment Connection(MultiplayerGame game) => __builder =>
    {
        <div class="relay-list" aria-label="Relays">
            @foreach (var (url, state) in Online.Links)
            {
                <span class="online-relay @(state == RelayLinkState.CaughtUp ? "ok" : "")" title="@url">
                    <span class="relay-dot"></span>@url.Host <span class="muted">@StateText(state)</span>
                </span>
            }
        </div>
    };

    private RenderFragment Transcript() => __builder =>
    {
        <details class="panel transcript-panel">
            <summary class="panel-title">Transcript <span class="muted">for comparing devices</span></summary>
            <pre class="online-transcript">@string.Join('\n', Online.Transcript)</pre>
            <button type="button" class="btn btn-quiet btn-sm" @onclick="() => CopyAsync(string.Join('\n', Online.Transcript), Copied.Transcript)">
                @(_copied == Copied.Transcript ? "Copied ✓" : "Copy transcript")
            </button>
        </details>
    };

    private static string NameFor(MultiplayerGame game, PlayerColor color) =>
        game.MyColor is not { } mine ? color.ToString() : mine == color ? "You" : "Opponent";

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    private string InviteLink(string code) => $"{Nav.BaseUri}online?invite={code}";

    private static string StateText(RelayLinkState state) =>
        state == RelayLinkState.CaughtUp ? "caught up" : state.ToString().ToLowerInvariant();

    private async Task RunAsync(Func<Task<string?>> action)
    {
        Error = null;
        Busy = true;
        try
        {
            Error = await action();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Busy = false;
            Stored = await Online.StoredGamesAsync();
        }
    }

    private static string StoredState(NetGameRecord record) => record.State switch
    {
        HandshakeState.Inviting => "waiting for a guest",
        HandshakeState.Joining => "waiting for the host",
        HandshakeState.InGame => "in progress",
        _ => record.State.ToString().ToLowerInvariant(),
    };

    private Task ResumeAsync(Guid gameId) => RunAsync(() => Online.ResumeAsync(gameId));

    private Task HostAsync() => RunAsync(() => Online.HostAsync(HostSize, HostKomiHalves));

    private Task JoinAsync() => RunAsync(() => Online.JoinAsync(InviteText));

    private Task RebuildAsync() => RunAsync(() => Online.RebuildAsync(InviteText));

    private async Task<CommandResult> SubmitAsync(TakMove move)
    {
        Error = null;
        return await Online.SubmitAsync(move);
    }

    private async Task SendPtnAsync()
    {
        Error = null;
        if (string.IsNullOrWhiteSpace(PtnText))
            return;
        CommandResult result = await Online.SubmitAsync(PtnText);
        if (result.IsSuccess)
            PtnText = "";
        else
            Error = result.ErrorMessage;
    }

    private async Task HandlePtnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SendPtnAsync();
    }

    private async Task ResignAsync() => await Online.ResignAsync();

    private async Task LeaveAsync()
    {
        await Online.LeaveAsync();
        Error = null;
        Stored = await Online.StoredGamesAsync();
    }

    private async Task CopyAsync(string text, Copied what)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            _copied = what;
        }
        catch (JSException)
        {
            Error = "Copy isn't allowed on this connection; select the text and copy it by hand.";
        }
    }

    public void Dispose() => Online.Changed -= Refresh;
}
