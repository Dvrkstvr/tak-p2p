@using System.Globalization
@using TakEngine.Abstractions
@using TakEngine.Core.Board

@if (Stack != null && !Stack.IsEmpty)
{
    var pieces = Stack.Pieces;
    int count = pieces.Count;

    const double stepX = 4.0;
    const double stepY = -5.5;

    double baseOffsetX = -((count - 1) * stepX) / 2.0;
    double baseOffsetY = -((count - 1) * stepY) / 2.0;

    for (int i = 0; i < count; i++)
    {
        var piece = pieces[i];
        bool isTop = (i == count - 1);
        double layerX = CenterX + baseOffsetX + i * stepX;
        double layerY = CenterY + baseOffsetY + i * stepY;

        string symbolId = GetSymbolId(piece, isTop);

        <use href="#@symbolId"
             x="@F(layerX - 32.0)"
             y="@F(layerY - 32.0)" />
    }

    @if (count >= 4)
    {
        double topX = CenterX + baseOffsetX + (count - 1) * stepX;
        double topY = CenterY + baseOffsetY + (count - 1) * stepY;
        @((MarkupString)$"<text x='{F(topX + 18.0)}' y='{F(topY - 8.0)}' fill='#d4a017' font-family=\"'JetBrains Mono', monospace\" font-size='9' font-weight='700'>{count}</text>")
    }
}

@code {
    [Parameter] public PieceStack? Stack { get; set; }
    [Parameter] public double CenterX { get; set; }
    [Parameter] public double CenterY { get; set; }
    [Parameter] public double Radius { get; set; } = 28;

    private static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    private static string GetSymbolId(Piece piece, bool isTop)
    {
        bool isWhite = piece.Color == PlayerColor.White;
        if (piece.Type == PieceType.Flat || (!isTop && piece.Type != PieceType.Flat))
        {
            return isWhite ? "tak-flat-white" : "tak-flat-black";
        }
        if (piece.Type == PieceType.Standing)
        {
            return isWhite ? "tak-wall-white" : "tak-wall-black";
        }
        return isWhite ? "tak-cap-white" : "tak-cap-black";
    }
}
