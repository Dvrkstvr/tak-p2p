@using TakEngine.Abstractions
@using TakEngine.Core.Board

<div class="board-wrapper">
    <svg class="tak-board-svg"
         viewBox="0 0 @TotalBoardDimension @TotalBoardDimension"
         width="@BoardPixelSize"
         height="@BoardPixelSize">
        
        <defs>
            <!-- White flat gradient -->
            <radialGradient id="grad-white-flat" cx="40%" cy="35%" r="65%">
                <stop offset="0%" stop-color="#ffffff" />
                <stop offset="70%" stop-color="#f1f5f9" />
                <stop offset="100%" stop-color="#cbd5e1" />
            </radialGradient>

            <!-- Black flat gradient -->
            <radialGradient id="grad-black-flat" cx="35%" cy="30%" r="70%">
                <stop offset="0%" stop-color="#334155" />
                <stop offset="60%" stop-color="#1e293b" />
                <stop offset="100%" stop-color="#090d16" />
            </radialGradient>

            <!-- White wall gradient -->
            <linearGradient id="grad-white-wall" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#ffffff" />
                <stop offset="50%" stop-color="#f8fafc" />
                <stop offset="100%" stop-color="#94a3b8" />
            </linearGradient>

            <!-- Black wall gradient -->
            <linearGradient id="grad-black-wall" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#475569" />
                <stop offset="50%" stop-color="#1e293b" />
                <stop offset="100%" stop-color="#020617" />
            </linearGradient>

            <!-- White capstone gradient -->
            <radialGradient id="grad-white-cap" cx="40%" cy="30%" r="70%">
                <stop offset="0%" stop-color="#ffffff" />
                <stop offset="60%" stop-color="#fef3c7" />
                <stop offset="100%" stop-color="#d97706" />
            </radialGradient>

            <!-- Black capstone gradient -->
            <radialGradient id="grad-black-cap" cx="35%" cy="30%" r="70%">
                <stop offset="0%" stop-color="#451a03" />
                <stop offset="50%" stop-color="#1c1917" />
                <stop offset="100%" stop-color="#090503" />
            </radialGradient>

            <!-- Winning road glow filter -->
            <filter id="road-glow" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="6" result="blur" />
                <feComposite in="SourceGraphic" in2="blur" operator="over" />
            </filter>
        </defs>

        <!-- Outer Frame -->
        <rect x="0" y="0"
              width="@TotalBoardDimension"
              height="@TotalBoardDimension"
              class="svg-board-frame" />

        <!-- Inner Playing Field -->
        <rect x="@BorderPadding"
              y="@BorderPadding"
              width="@PlayfieldDimension"
              height="@PlayfieldDimension"
              rx="8"
              class="svg-board-inner" />

        <!-- Coordinates Labels: Files (a, b, c...) at bottom and top -->
        @for (int x = 0; x < SizeInt; x++)
        {
            char fileChar = (char)('a' + x);
            double labelX = BorderPadding + x * SquareSize + SquareSize / 2;
            @((MarkupString)$"<text x='{labelX}' y='{BorderPadding / 2 + 1}' class='svg-coord-label'>{fileChar}</text>")
            @((MarkupString)$"<text x='{labelX}' y='{TotalBoardDimension - BorderPadding / 2}' class='svg-coord-label'>{fileChar}</text>")
        }

        <!-- Coordinates Labels: Ranks (1, 2, 3...) at left and right -->
        @for (int y = 0; y < SizeInt; y++)
        {
            // Note: Tak Y=0 is Rank 1 at bottom; Y=SizeInt-1 is top rank
            int rankNum = y + 1;
            double labelY = BorderPadding + (SizeInt - 1 - y) * SquareSize + SquareSize / 2;
            @((MarkupString)$"<text x='{BorderPadding / 2}' y='{labelY}' class='svg-coord-label'>{rankNum}</text>")
            @((MarkupString)$"<text x='{TotalBoardDimension - BorderPadding / 2}' y='{labelY}' class='svg-coord-label'>{rankNum}</text>")
        }

        <!-- Squares -->
        @for (int x = 0; x < SizeInt; x++)
        {
            @for (int y = 0; y < SizeInt; y++)
            {
                var coord = new Coord(x, y);
                double sqX = BorderPadding + x * SquareSize;
                double sqY = BorderPadding + (SizeInt - 1 - y) * SquareSize;
                bool isLight = (x + y) % 2 == 1;
                bool isSelected = SelectedCoord.HasValue && SelectedCoord.Value == coord;
                bool isLegal = LegalTargets.Contains(coord);
                bool isRoad = WinningRoad.Contains(coord);
                bool isLastMove = LastMoveTarget.HasValue && LastMoveTarget.Value == coord;

                string sqClass = $"svg-sq {(isLight ? "sq-light" : "sq-dark")} {(isSelected ? "selected" : "")} {(isLegal ? "legal-target" : "")}";

                <g @onclick="() => HandleSquareClick(coord)">
                    <rect x="@sqX"
                          y="@sqY"
                          width="@SquareSize"
                          height="@SquareSize"
                          rx="4"
                          class="@sqClass" />

                    @if (isRoad)
                    {
                        <rect x="@(sqX + 2)"
                              y="@(sqY + 2)"
                              width="@(SquareSize - 4)"
                              height="@(SquareSize - 4)"
                              rx="4"
                              fill="none"
                              stroke="#f59e0b"
                              stroke-width="3.5"
                              filter="url(#road-glow)" />
                    }

                    @if (isLastMove)
                    {
                        <rect x="@(sqX + 3)"
                              y="@(sqY + 3)"
                              width="@(SquareSize - 6)"
                              height="@(SquareSize - 6)"
                              rx="4"
                              fill="none"
                              stroke="#06b6d4"
                              stroke-width="1.8"
                              stroke-dasharray="4,2" />
                    }

                    <!-- Legal placement marker dot -->
                    @if (isLegal && (Board == null || Board.GetStack(coord).IsEmpty))
                    {
                        <circle cx="@(sqX + SquareSize / 2)"
                                cy="@(sqY + SquareSize / 2)"
                                r="@(SquareSize * 0.12)"
                                class="legal-marker" />
                    }

                    <!-- Piece Stack -->
                    @if (Board != null)
                    {
                        var stack = Board.GetStack(coord);
                        if (!stack.IsEmpty)
                        {
                            <PieceStackSvg Stack="stack"
                                           CenterX="@(sqX + SquareSize / 2)"
                                           CenterY="@(sqY + SquareSize / 2)"
                                           Radius="@(SquareSize * 0.38)" />
                        }
                    }
                </g>
            }
        }
    </svg>
</div>

@code {
    [Parameter] public GameBoard? Board { get; set; }
    [Parameter] public Coord? SelectedCoord { get; set; }
    [Parameter] public Coord? LastMoveTarget { get; set; }
    [Parameter] public HashSet<Coord> LegalTargets { get; set; } = new();
    [Parameter] public HashSet<Coord> WinningRoad { get; set; } = new();
    [Parameter] public EventCallback<Coord> OnSquareClick { get; set; }

    public int SizeInt => Board != null ? (int)Board.Size : 5;
    public double SquareSize => 80;
    public double BorderPadding => 32;
    public double PlayfieldDimension => SizeInt * SquareSize;
    public double TotalBoardDimension => PlayfieldDimension + BorderPadding * 2;
    public string BoardPixelSize => "100%";

    private async Task HandleSquareClick(Coord coord)
    {
        if (OnSquareClick.HasDelegate)
        {
            await OnSquareClick.InvokeAsync(coord);
        }
    }
}
