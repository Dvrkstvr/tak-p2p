@using System.Globalization
@using TakEngine.Abstractions
@using TakEngine.Core.Board

<div class="board-stage">
    <div class="board-surface">
        <svg class="tak-board-svg"
             viewBox="0 0 @F(TotalBoardDimension) @F(TotalBoardDimension)"
             xmlns="http://www.w3.org/2000/svg">

            <defs>
                <!-- White Flat Stone (2.5D slab) -->
                <g id="tak-flat-white">
                    <rect x="16" y="19" width="32" height="32" fill="#9ca3af" />
                    <rect x="16" y="15" width="32" height="32" fill="#ffffff" stroke="#e5e7eb" stroke-width="1" />
                    <rect x="18" y="17" width="28" height="28" fill="none" stroke="#f3f4f6" stroke-width="0.75" />
                </g>

                <!-- Black Flat Stone (2.5D slab) -->
                <g id="tak-flat-black">
                    <rect x="16" y="19" width="32" height="32" fill="#111827" />
                    <rect x="16" y="15" width="32" height="32" fill="#2d3748" stroke="#ffffff" stroke-width="1" />
                    <rect x="18" y="17" width="28" height="28" fill="none" stroke="#4a5568" stroke-width="0.75" />
                </g>

                <!-- White Standing Wall (Tall 48px upright prism) -->
                <g id="tak-wall-white">
                    <ellipse cx="32" cy="58" rx="12" ry="4" fill="rgba(0,0,0,0.4)" />
                    <rect x="23" y="10" width="3" height="48" fill="#9ca3af" />
                    <rect x="25" y="8" width="14" height="50" fill="#ffffff" stroke="#e5e7eb" stroke-width="1" />
                    <polygon points="23,10 25,8 39,8 37,10" fill="#cbd5e1" />
                    <line x1="32" y1="10" x2="32" y2="56" stroke="#e2e8f0" stroke-width="1" />
                </g>

                <!-- Black Standing Wall (Tall 48px upright prism) -->
                <g id="tak-wall-black">
                    <ellipse cx="32" cy="58" rx="12" ry="4" fill="rgba(0,0,0,0.6)" />
                    <rect x="23" y="10" width="3" height="48" fill="#111827" />
                    <rect x="25" y="8" width="14" height="50" fill="#2d3748" stroke="#ffffff" stroke-width="1" />
                    <polygon points="23,10 25,8 39,8 37,10" fill="#4a5568" />
                    <line x1="32" y1="10" x2="32" y2="56" stroke="#4a5568" stroke-width="1" />
                </g>

                <!-- White Capstone (Tall cylindrical pillar with amber crown) -->
                <g id="tak-cap-white">
                    <ellipse cx="32" cy="56" rx="16" ry="5" fill="rgba(0,0,0,0.4)" />
                    <ellipse cx="32" cy="52" rx="12" ry="5" fill="#cbd5e1" />
                    <rect x="20" y="20" width="24" height="32" fill="#f8fafc" stroke="#ffffff" stroke-width="1" />
                    <rect x="20" y="20" width="5" height="32" fill="#cbd5e1" opacity="0.6" />
                    <ellipse cx="32" cy="20" rx="12" ry="6" fill="#ffffff" stroke="#d4a017" stroke-width="2.5" />
                    <ellipse cx="32" cy="20" rx="7" ry="3.5" fill="none" stroke="#d4a017" stroke-width="1.2" />
                    <polygon points="32,10 36,15 32,20 28,15" fill="#d4a017" stroke="#d4a017" stroke-width="0.8" />
                </g>

                <!-- Black Capstone (Tall cylindrical pillar with amber crown) -->
                <g id="tak-cap-black">
                    <ellipse cx="32" cy="56" rx="16" ry="5" fill="rgba(0,0,0,0.6)" />
                    <ellipse cx="32" cy="52" rx="12" ry="5" fill="#141414" />
                    <rect x="20" y="20" width="24" height="32" fill="#1e2430" stroke="#ffffff" stroke-width="1" />
                    <rect x="20" y="20" width="5" height="32" fill="#0f1318" opacity="0.8" />
                    <ellipse cx="32" cy="20" rx="12" ry="6" fill="#141414" stroke="#d4a017" stroke-width="2.5" />
                    <ellipse cx="32" cy="20" rx="7" ry="3.5" fill="none" stroke="#d4a017" stroke-width="1.2" />
                    <polygon points="32,10 36,15 32,20 28,15" fill="#d4a017" stroke="#d4a017" stroke-width="0.8" />
                </g>
            </defs>

            <!-- Solid Black Board Base -->
            <rect x="0" y="0"
                  width="@F(TotalBoardDimension)"
                  height="@F(TotalBoardDimension)"
                  fill="#0a0a0a" />

            <!-- Board Playing Field Outer Border -->
            <rect x="@F(BorderPadding)"
                  y="@F(BorderPadding)"
                  width="@F(PlayfieldDimension)"
                  height="@F(PlayfieldDimension)"
                  fill="#0a0a0a"
                  stroke="#ffffff"
                  stroke-width="1.5" />

            <!-- Coordinates: Files (a, b, c...) at bottom and top -->
            @for (int x = 0; x < SizeInt; x++)
            {
                char fileChar = (char)('a' + x);
                double labelX = BorderPadding + x * SquareSize + SquareSize / 2.0;
                @((MarkupString)$"<text x='{F(labelX)}' y='{F(BorderPadding / 2.0 + 3)}' fill='#555555' font-family=\"'JetBrains Mono', monospace\" font-size='11' font-weight='500' text-anchor='middle' dominant-baseline='central'>{fileChar}</text>")
                @((MarkupString)$"<text x='{F(labelX)}' y='{F(TotalBoardDimension - BorderPadding / 2.0 + 1)}' fill='#555555' font-family=\"'JetBrains Mono', monospace\" font-size='11' font-weight='500' text-anchor='middle' dominant-baseline='central'>{fileChar}</text>")
            }

            <!-- Coordinates: Ranks (1, 2, 3...) at left and right -->
            @for (int y = 0; y < SizeInt; y++)
            {
                int rankNum = y + 1;
                double labelY = BorderPadding + (SizeInt - 1 - y) * SquareSize + SquareSize / 2.0;
                @((MarkupString)$"<text x='{F(BorderPadding / 2.0)}' y='{F(labelY + 1)}' fill='#555555' font-family=\"'JetBrains Mono', monospace\" font-size='11' font-weight='500' text-anchor='middle' dominant-baseline='central'>{rankNum}</text>")
                @((MarkupString)$"<text x='{F(TotalBoardDimension - BorderPadding / 2.0)}' y='{F(labelY + 1)}' fill='#555555' font-family=\"'JetBrains Mono', monospace\" font-size='11' font-weight='500' text-anchor='middle' dominant-baseline='central'>{rankNum}</text>")
            }

            <!-- Grid Squares -->
            @for (int x = 0; x < SizeInt; x++)
            {
                @for (int y = 0; y < SizeInt; y++)
                {
                    var coord = new Coord(x, y);
                    double sqX = BorderPadding + x * SquareSize;
                    double sqY = BorderPadding + (SizeInt - 1 - y) * SquareSize;
                    bool isSelected = SelectedCoord.HasValue && SelectedCoord.Value == coord;
                    bool isLegalPlacement = LegalTargets.Contains(coord);
                    bool isLegalSlide = LegalSlideTargets.Contains(coord);
                    bool isRoad = WinningRoad.Contains(coord);
                    bool isLastMove = LastMoveTarget.HasValue && LastMoveTarget.Value == coord;
                    bool isInspected = InspectingCoord.HasValue && InspectingCoord.Value == coord;

                    <g @onclick="() => HandleSquareClick(coord)"
                       @oncontextmenu="() => HandleSquareRightClick(coord)"
                       @oncontextmenu:preventDefault="true">
                        <!-- Square Boundary and Hover Target -->
                        <rect x="@F(sqX)"
                              y="@F(sqY)"
                              width="@F(SquareSize)"
                              height="@F(SquareSize)"
                              fill="#0a0a0a"
                              stroke="#ffffff"
                              stroke-width="1"
                              class="svg-sq @(isSelected ? "selected" : "") @(isLegalPlacement ? "legal-target" : "") @(isLegalSlide ? "legal-slide-target" : "") @(isInspected ? "inspected-target" : "")" />

                        <!-- Winning Road Highlight in Amber -->
                        @if (isRoad)
                        {
                            <rect x="@F(sqX + 2)"
                                  y="@F(sqY + 2)"
                                  width="@F(SquareSize - 4)"
                                  height="@F(SquareSize - 4)"
                                  class="svg-road-highlight" />
                        }

                        <!-- Last Move Target Outline -->
                        @if (isLastMove)
                        {
                            <rect x="@F(sqX + 3)"
                                  y="@F(sqY + 3)"
                                  width="@F(SquareSize - 6)"
                                  height="@F(SquareSize - 6)"
                                  class="svg-last-move" />
                        }

                        <!-- Legal Placement Dot (if empty) -->
                        @if (isLegalPlacement && (Board == null || Board.GetStack(coord).IsEmpty))
                        {
                            <circle cx="@F(sqX + SquareSize / 2.0)"
                                    cy="@F(sqY + SquareSize / 2.0)"
                                    r="@F(SquareSize * 0.08)"
                                    class="svg-legal-marker" />
                        }

                        <!-- Legal Slide Target Marker (PlayTak directional slide target) -->
                        @if (isLegalSlide)
                        {
                            <circle cx="@F(sqX + SquareSize / 2.0)"
                                    cy="@F(sqY + SquareSize / 2.0)"
                                    r="@F(SquareSize * 0.14)"
                                    class="svg-slide-marker" />
                            <circle cx="@F(sqX + SquareSize / 2.0)"
                                    cy="@F(sqY + SquareSize / 2.0)"
                                    r="@F(SquareSize * 0.22)"
                                    class="svg-slide-ring" />
                        }

                        <!-- Piece Stack -->
                        @if (Board != null)
                        {
                            var stack = Board.GetStack(coord);
                            if (!stack.IsEmpty)
                            {
                                <PieceStackSvg Stack="stack"
                                               CenterX="@(sqX + SquareSize / 2.0)"
                                               CenterY="@(sqY + SquareSize / 2.0)"
                                               Radius="@(SquareSize * 0.38)" />
                            }
                        }

                        <!-- Stack Inspector Halo if inspected -->
                        @if (isInspected)
                        {
                            <rect x="@F(sqX + 1)"
                                  y="@F(sqY + 1)"
                                  width="@F(SquareSize - 2)"
                                  height="@F(SquareSize - 2)"
                                  fill="rgba(59, 130, 246, 0.2)"
                                  stroke="#3b82f6"
                                  stroke-width="2" />
                        }
                    </g>
                }
            }

            <!-- Floating Stack Inspector Overlay on Board if active -->
            @if (InspectingCoord.HasValue && Board != null)
            {
                var insCoord = InspectingCoord.Value;
                var insStack = Board.GetStack(insCoord);
                if (!insStack.IsEmpty)
                {
                    double overlayX = Math.Min(TotalBoardDimension - 170.0, Math.Max(BorderPadding, BorderPadding + insCoord.X * SquareSize));
                    double overlayY = Math.Max(BorderPadding, BorderPadding + (SizeInt - 1 - insCoord.Y) * SquareSize - (insStack.Height * 22.0 + 35.0));

                    <g class="svg-inspector-group" @onclick="HandleDismissInspect" @oncontextmenu="HandleDismissInspect" @oncontextmenu:preventDefault="true">
                        <rect x="@F(overlayX)"
                              y="@F(overlayY)"
                              width="160"
                              height="@F(insStack.Height * 22.0 + 32.0)"
                              rx="6"
                              fill="rgba(10, 10, 12, 0.95)"
                              stroke="#d4a017"
                              stroke-width="1.5"
                              filter="drop-shadow(0 4px 12px rgba(0,0,0,0.8))" />

                        @((MarkupString)$"<text x='{F(overlayX + 8)}' y='{F(overlayY + 16)}' fill='#d4a017' font-family=\"'JetBrains Mono', monospace\" font-size='11' font-weight='700'>{insCoord.ToAlgebraic().ToUpperInvariant()} (H:{insStack.Height}) ✕</text>")

                        @for (int idx = insStack.Height - 1; idx >= 0; idx--)
                        {
                            var p = insStack.Pieces[idx];
                            int layerNum = idx + 1;
                            double itemY = overlayY + 32.0 + (insStack.Height - 1 - idx) * 22.0;
                            string pColor = p.Color == PlayerColor.White ? "White" : "Black";
                            string pType = p.Type switch
                            {
                                PieceType.Flat => "Flat",
                                PieceType.Standing => "Wall",
                                PieceType.Capstone => "Cap",
                                _ => ""
                            };
                            string dotColor = p.Color == PlayerColor.White ? "#ffffff" : "#64748b";
                            string star = idx == insStack.Height - 1 ? "★" : "";

                            <circle cx="@F(overlayX + 16)"
                                    cy="@F(itemY - 4)"
                                    r="4.5"
                                    fill="@dotColor"
                                    stroke="@(p.Color == PlayerColor.White ? "#94a3b8" : "#ffffff")"
                                    stroke-width="0.75" />

                            @((MarkupString)$"<text x='{F(overlayX + 28)}' y='{F(itemY)}' fill='#f8fafc' font-family=\"'JetBrains Mono', monospace\" font-size='10.5'>{layerNum}: {pColor} {pType} {star}</text>")
                        }
                    </g>
                }
            }
        </svg>
    </div>
</div>

@code {
    [Parameter] public GameBoard? Board { get; set; }
    [Parameter] public Coord? SelectedCoord { get; set; }
    [Parameter] public Coord? LastMoveTarget { get; set; }
    [Parameter] public HashSet<Coord> LegalTargets { get; set; } = new();
    [Parameter] public HashSet<Coord> LegalSlideTargets { get; set; } = new();
    [Parameter] public Coord? InspectingCoord { get; set; }
    [Parameter] public HashSet<Coord> WinningRoad { get; set; } = new();
    [Parameter] public bool Is25D { get; set; } = true;
    [Parameter] public EventCallback<Coord> OnSquareClick { get; set; }
    [Parameter] public EventCallback<Coord> OnSquareRightClick { get; set; }
    [Parameter] public EventCallback OnDismissInspect { get; set; }

    public int SizeInt => Board != null ? (int)Board.Size : 5;
    public double SquareSize => 80.0;
    public double BorderPadding => 26.0;
    public double PlayfieldDimension => SizeInt * SquareSize;
    public double TotalBoardDimension => PlayfieldDimension + BorderPadding * 2.0;

    private static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    private async Task HandleSquareClick(Coord coord)
    {
        if (OnSquareClick.HasDelegate)
        {
            await OnSquareClick.InvokeAsync(coord);
        }
    }

    private async Task HandleSquareRightClick(Coord coord)
    {
        if (OnSquareRightClick.HasDelegate)
        {
            await OnSquareRightClick.InvokeAsync(coord);
        }
    }

    private async Task HandleDismissInspect()
    {
        if (OnDismissInspect.HasDelegate)
        {
            await OnDismissInspect.InvokeAsync();
        }
    }
}
