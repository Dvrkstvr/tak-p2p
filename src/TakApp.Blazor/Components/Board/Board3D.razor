@using System.Text
@using System.Text.Json
@using TakEngine.Abstractions
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IAsyncDisposable

@* The 3D board: wwwroot/js/board3d.js draws the BoardScene with three.js and reports clicks; the table owns the gestures. *@
<div class="board3d @(Interactive ? "" : "static")" @ref="_host">
    @if (Interactive)
    {
        <div class="board3d-tools">
            <button type="button" class="icon-btn" title="Reset camera" aria-label="Reset camera" @onclick="ResetView">⟲</button>
            <button type="button" class="icon-btn" title="Top-down camera" aria-label="Top-down camera" @onclick="TopView">⊡</button>
        </div>
        <div class="board3d-hint">Drag to orbit · scroll or pinch to zoom@(TouchHint)</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public BoardScene Scene { get; set; } = default!;
    [Parameter] public bool Flipped { get; set; }
    [Parameter] public bool Interactive { get; set; } = true;
    [Parameter] public bool AutoRotate { get; set; }
    [Parameter] public EventCallback<Coord> SquareClick { get; set; }
    [Parameter] public EventCallback<Coord> SquareRightClick { get; set; }
    [Parameter] public EventCallback BackgroundClick { get; set; }

    /// <summary>Raised when this browser cannot draw WebGL, or the context was lost; the table then shows the 2D board.</summary>
    [Parameter] public EventCallback Unavailable { get; set; }

    private const string TouchHint = " · long-press = right-click";

    private ElementReference _host;
    private IJSObjectReference? _module;
    private IJSObjectReference? _view;
    private DotNetObjectReference<Board3D>? _self;
    private string? _sent;
    private bool _failed;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_failed || _disposed)
            return;
        try
        {
            if (firstRender)
            {
                _self = DotNetObjectReference.Create(this);
                _module = await JS.InvokeAsync<IJSObjectReference>("import", Nav.ToAbsoluteUri("js/board3d.js").ToString());
                // The page may have moved on (2D picked, game left) while the module loaded.
                if (_disposed)
                    return;
                _view = await _module.InvokeAsync<IJSObjectReference?>("create", _host, _self,
                    new { autoRotate = AutoRotate, interactive = Interactive });
                if (_disposed)
                {
                    await DisposeViewAsync();
                    return;
                }
                if (_view is null)
                {
                    await FailAsync();
                    return;
                }
            }

            string json = Serialize(Scene, Flipped);
            if (_view is not null && json != _sent)
            {
                _sent = json;
                await _view.InvokeVoidAsync("update", json);
            }
        }
        catch (JSException)
        {
            await FailAsync();
        }
        catch (ObjectDisposedException)
        {
            // Disposed between two awaits: nothing left to draw.
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task FailAsync()
    {
        _failed = true;
        await Unavailable.InvokeAsync();
    }

    private async Task ResetView()
    {
        if (_view is not null)
            await _view.InvokeVoidAsync("resetView", false);
    }

    private async Task TopView()
    {
        if (_view is not null)
            await _view.InvokeVoidAsync("topView");
    }

    [JSInvokable]
    public Task OnSquareClick(string coord) => SquareClick.InvokeAsync(Coord.FromAlgebraic(coord));

    [JSInvokable]
    public Task OnSquareRightClick(string coord) => SquareRightClick.InvokeAsync(Coord.FromAlgebraic(coord));

    [JSInvokable]
    public Task OnBackgroundClick() => BackgroundClick.InvokeAsync();

    [JSInvokable]
    public Task OnContextLost() => FailAsync();

    /// <summary>The scene as board3d.js reads it: pieces as colour/type letter pairs, marks as flag letters.</summary>
    internal static string Serialize(BoardScene scene, bool flipped)
    {
        var squares = scene.Squares.Select(s => new object[] { s.Coord.ToAlgebraic(), Pieces(s.Pieces), Flags(s), s.Dropped }).ToArray();
        object? hand = scene.HandAt is { } at ? new { c = at.ToAlgebraic(), p = Pieces(scene.Hand) } : null;
        return JsonSerializer.Serialize(new
        {
            n = scene.Size,
            flip = flipped,
            sq = squares,
            hand,
            origin = scene.Origin?.ToAlgebraic(),
            carry = scene.Carry,
        });
    }

    private static string Pieces(IReadOnlyList<Piece> pieces)
    {
        var sb = new StringBuilder(pieces.Count * 2);
        foreach (var p in pieces)
        {
            sb.Append(p.Color == PlayerColor.White ? 'w' : 'b');
            sb.Append(p.Type switch { PieceType.Standing => 'S', PieceType.Capstone => 'C', _ => 'F' });
        }
        return sb.ToString();
    }

    private static string Flags(SquareView s)
    {
        var sb = new StringBuilder();
        if (s.Selected) sb.Append('S');
        if (s.PlaceTarget) sb.Append('P');
        if (s.SlideTarget) sb.Append('T');
        if (s.CurrentStep) sb.Append('C');
        if (s.NextStep) sb.Append('N');
        if (s.LastMove) sb.Append('L');
        if (s.Road) sb.Append('R');
        if (s.Inspected) sb.Append('I');
        return sb.ToString();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await DisposeViewAsync();
        try
        {
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (Exception e) when (e is JSDisconnectedException or JSException)
        {
        }
        _module = null;
        _self?.Dispose();
    }

    private async Task DisposeViewAsync()
    {
        var view = _view;
        _view = null;
        if (view is null)
            return;
        try
        {
            await view.InvokeVoidAsync("dispose");
            await view.DisposeAsync();
        }
        catch (Exception e) when (e is JSDisconnectedException or JSException)
        {
        }
    }
}
