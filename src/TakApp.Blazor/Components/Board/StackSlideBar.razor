@using TakEngine.Abstractions
@using TakEngine.Core.Board
@using TakEngine.Core.Rules

@if (OriginCoord.HasValue && Board != null && AvailableSlideMoves.Any())
{
    var origin = OriginCoord.Value;
    var stack = Board.GetStack(origin);

    <div class="slide-control-box">
        <div class="slide-control-header">
            <span>Or pick the move: stack on <strong>@origin.ToAlgebraic()</strong> (@stack.Height high, carry up to @Board.CarryLimit)</span>
            <button type="button" class="btn btn-quiet btn-sm" @onclick="OnCancel">✕ Cancel</button>
        </div>

        <div class="slide-control-body">
            <div class="dir-picker" role="group" aria-label="Direction">
                @foreach (var dir in new[] { Direction.North, Direction.West, Direction.East, Direction.South })
                {
                    bool hasMoves = AvailableSlideMoves.Any(m => m.Direction == dir);
                    string arrow = dir switch
                    {
                        Direction.North => "↑",
                        Direction.South => "↓",
                        Direction.East => "→",
                        Direction.West => "←",
                        _ => "?"
                    };

                    <button type="button" class="btn-dir-key dir-@dir.ToString().ToLowerInvariant() @(SelectedDirection == dir ? "selected" : "")"
                            disabled="@(!hasMoves)" aria-label="@dir"
                            @onclick="() => SelectDirection(dir)">
                        @arrow
                    </button>
                }
            </div>

            @if (SelectedDirection.HasValue)
            {
                var matchingMoves = AvailableSlideMoves.Where(m => m.Direction == SelectedDirection.Value).ToList();
                <div class="drop-picker">
                    @foreach (var move in matchingMoves)
                    {
                        <button type="button" class="drop-chip @(SelectedMove == move ? "selected" : "")" @onclick="() => SelectMove(move)">
                            @move.LiftCount → @string.Join("-", move.Drops)
                        </button>
                    }
                </div>
            }
        </div>

        @if (SelectedMove != null)
        {
            <div class="slide-control-foot">
                <button type="button" class="btn btn-primary btn-sm" @onclick="ConfirmSlide">
                    Confirm Move (@SelectedMove.ToPtn())
                </button>
            </div>
        }
    </div>
}

@code {
    [Parameter] public Coord? OriginCoord { get; set; }
    [Parameter] public GameBoard? Board { get; set; }
    [Parameter] public Direction? ActiveDirection { get; set; }
    [Parameter] public EventCallback<SlideMove> OnSlideConfirmed { get; set; }
    [Parameter] public EventCallback OnCancelRequested { get; set; }

    private Direction? SelectedDirection { get; set; }
    private SlideMove? SelectedMove { get; set; }

    private List<SlideMove> AvailableSlideMoves
    {
        get
        {
            if (!OriginCoord.HasValue || Board == null) return new();
            var moves = MoveValidator.GetLegalMovesForSquare(Board, OriginCoord.Value);
            return moves.OfType<SlideMove>().ToList();
        }
    }

    private Coord? _shownOrigin;

    protected override void OnParametersSet()
    {
        // A new origin (or none) starts the bar afresh: a choice made for another stack must never be confirmed for this one
        // (pipeline/design/gestures.md G-43).
        if (OriginCoord != _shownOrigin)
        {
            _shownOrigin = OriginCoord;
            SelectedDirection = null;
            SelectedMove = null;
        }

        if (ActiveDirection.HasValue && AvailableSlideMoves.Any(m => m.Direction == ActiveDirection.Value))
        {
            SelectedDirection = ActiveDirection.Value;
            SelectedMove = AvailableSlideMoves.FirstOrDefault(m => m.Direction == SelectedDirection);
        }
        else if (OriginCoord.HasValue && SelectedDirection == null && AvailableSlideMoves.Any())
        {
            SelectedDirection = AvailableSlideMoves.First().Direction;
            SelectedMove = AvailableSlideMoves.FirstOrDefault(m => m.Direction == SelectedDirection);
        }
    }

    private void SelectDirection(Direction dir)
    {
        SelectedDirection = dir;
        SelectedMove = AvailableSlideMoves.FirstOrDefault(m => m.Direction == dir);
    }

    private void SelectMove(SlideMove move)
    {
        SelectedMove = move;
    }

    private async Task ConfirmSlide()
    {
        if (SelectedMove != null && OnSlideConfirmed.HasDelegate)
        {
            await OnSlideConfirmed.InvokeAsync(SelectedMove);
            SelectedDirection = null;
            SelectedMove = null;
        }
    }

    private async Task OnCancel()
    {
        SelectedDirection = null;
        SelectedMove = null;
        if (OnCancelRequested.HasDelegate)
        {
            await OnCancelRequested.InvokeAsync();
        }
    }
}
