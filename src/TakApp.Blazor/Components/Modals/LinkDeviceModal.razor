@using TakApp.Blazor.Services
@using TakEngine.Core.Cryptography
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject BrowserStorage Storage

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal" role="dialog" aria-label="Your key and devices" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>Your key and devices</h3>
                <button type="button" class="icon-btn" aria-label="Close" @onclick="Close">✕</button>
            </div>

            <div class="copy-field">
                <div class="copy-field-text">
                    <span class="field-label">Public id (npub)</span>
                    <code>@FormattedNpub</code>
                </div>
                <button type="button" class="btn btn-quiet btn-sm" @onclick="CopyNpub">@(CopiedNpub ? "Copied ✓" : "Copy")</button>
            </div>

            <div class="seg tabs" role="tablist">
                <button type="button" class="seg-btn @(ActiveTab == "backup" ? "active" : "")" @onclick='() => ActiveTab = "backup"'>Back up this key</button>
                <button type="button" class="seg-btn @(ActiveTab == "import" ? "active" : "")" @onclick='() => ActiveTab = "import"'>Use an existing key</button>
            </div>

            @if (ActiveTab == "import")
            {
                <p class="card-text">Play as the same player on this device: paste your secret key (<code>nsec1…</code> or 64 hex characters).
                    It replaces this browser's key.</p>
                <input class="input mono" type="password" @bind="InputPrivateKey" placeholder="nsec1… or hex secret key" autocomplete="off" />
                @if (!string.IsNullOrEmpty(ImportError))
                {
                    <div class="notice error">@ImportError</div>
                }
                @if (ImportSuccess)
                {
                    <div class="notice ok">This device now uses that key.</div>
                }
                <div class="modal-foot">
                    <button type="button" class="btn btn-primary" @onclick="SubmitImport">Use this key</button>
                </div>
            }
            else
            {
                <p class="card-text">Your secret key is who you are in online games. Keep a copy in a password manager; anyone with it can play as you.</p>
                <div class="secret-box mono">@(RevealNsec ? FullNsec : "••••••••••••••••••••••••••••••••••••••••••••••••")</div>
                <div class="modal-foot">
                    <button type="button" class="btn btn-quiet btn-sm" @onclick="() => RevealNsec = !RevealNsec">@(RevealNsec ? "Hide" : "Reveal")</button>
                    <button type="button" class="btn btn-primary btn-sm" @onclick="CopyNsec">@(CopiedNsec ? "Copied ✓" : "Copy nsec")</button>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnIdentityChanged { get; set; }

    private string ActiveTab { get; set; } = "backup";
    private string FormattedNpub { get; set; } = "";
    private string FullNpub { get; set; } = "";
    private string FullNsec { get; set; } = "";
    private string PrivateKeyHex { get; set; } = "";
    private string PublicKeyHex { get; set; } = "";

    private string InputPrivateKey { get; set; } = "";
    private string? ImportError { get; set; }
    private bool ImportSuccess { get; set; } = false;

    private bool RevealNsec { get; set; } = false;
    private bool CopiedNpub { get; set; } = false;
    private bool CopiedNsec { get; set; } = false;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen)
        {
            await RefreshKeys();
        }
    }

    private async Task RefreshKeys()
    {
        var (privHex, pubHex) = await Storage.GetOrCreateKeypairAsync();
        PrivateKeyHex = privHex;
        PublicKeyHex = pubHex;

        try
        {
            FullNpub = Nip19.ToNpub(pubHex);
            FullNsec = Nip19.ToNsec(privHex);
            FormattedNpub = FullNpub.Length > 20 ? $"{FullNpub[..12]}...{FullNpub[^8..]}" : FullNpub;
        }
        catch
        {
            FullNpub = pubHex;
            FullNsec = privHex;
            FormattedNpub = $"{pubHex[..8]}...{pubHex[^6..]}";
        }
    }

    private async Task CopyNpub()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", FullNpub);
        CopiedNpub = true;
        StateHasChanged();
    }

    private async Task CopyNsec()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", FullNsec);
        CopiedNsec = true;
        StateHasChanged();
    }

    private async Task SubmitImport()
    {
        ImportError = null;
        ImportSuccess = false;

        if (string.IsNullOrWhiteSpace(InputPrivateKey))
        {
            ImportError = "Please provide a private key.";
            return;
        }

        try
        {
            await Storage.ImportPrivateKeyAsync(InputPrivateKey.Trim());
            await RefreshKeys();
            InputPrivateKey = "";
            ImportSuccess = true;

            if (OnIdentityChanged.HasDelegate)
            {
                await OnIdentityChanged.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            ImportError = $"Invalid key: {ex.Message}";
        }
    }

    private async Task Close()
    {
        RevealNsec = false;
        ImportError = null;
        ImportSuccess = false;
        CopiedNpub = false;
        CopiedNsec = false;

        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }
}
