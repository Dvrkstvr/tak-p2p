@using TakApp.Blazor.Services
@using TakEngine.Core.Cryptography
@using TakEngine.Transport.Nostr
@inject BrowserStorage Storage
@inject IJSRuntime JS

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal" role="dialog" aria-label="Profile" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>Your profile</h3>
                <button type="button" class="icon-btn" aria-label="Close" @onclick="Close">✕</button>
            </div>

            <div class="profile-preview">
                <div class="avatar">
                    @if (!string.IsNullOrWhiteSpace(InputPicture))
                    {
                        <img src="@InputPicture" alt="" @onerror="HandleImageError" />
                    }
                    else
                    {
                        <span>@(GetInitials(InputDisplayName))</span>
                    }
                </div>
                <div class="profile-preview-text">
                    <div class="profile-name">@(string.IsNullOrWhiteSpace(InputDisplayName) ? "Anonymous" : InputDisplayName)</div>
                    <code class="muted">@FormattedNpub</code>
                </div>
            </div>

            <label class="field">
                <span class="field-label">Nickname</span>
                <input class="input" type="text" @bind="InputDisplayName" @bind:event="oninput" placeholder="What should we call you?" maxlength="32" />
                <span class="field-help">Shown as your name in local and AI games on this device.</span>
            </label>
            <label class="field">
                <span class="field-label">About <span class="muted">(optional)</span></span>
                <input class="input" type="text" @bind="InputAbout" @bind:event="oninput" maxlength="100" />
            </label>
            <label class="field">
                <span class="field-label">Avatar URL <span class="muted">(optional)</span></span>
                <input class="input" type="url" @bind="InputPicture" @bind:event="oninput" placeholder="https://…" />
            </label>

            @if (!string.IsNullOrEmpty(StatusMessage))
            {
                <div class="notice @(IsError ? "error" : "ok")">@StatusMessage</div>
            }

            <div class="modal-foot">
                <button type="button" class="btn btn-quiet" @onclick="Close">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="SaveProfile" disabled="@IsSaving">@(IsSaving ? "Saving…" : "Save")</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnProfileSaved { get; set; }

    private string InputDisplayName { get; set; } = "";
    private string InputAbout { get; set; } = "";
    private string InputPicture { get; set; } = "";

    private string FormattedNpub { get; set; } = "";
    private string? StatusMessage { get; set; }
    private bool IsError { get; set; }
    private bool IsSaving { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen)
        {
            StatusMessage = null;
            IsError = false;
            var (_, pubHex) = await Storage.GetOrCreateKeypairAsync();
            try
            {
                string npub = Nip19.ToNpub(pubHex);
                FormattedNpub = npub.Length > 20 ? $"{npub[..12]}...{npub[^8..]}" : npub;
            }
            catch
            {
                FormattedNpub = pubHex.Length > 12 ? $"{pubHex[..8]}...{pubHex[^4..]}" : pubHex;
            }

            var profile = await Storage.GetProfileAsync();
            InputDisplayName = profile.DisplayName ?? profile.Name ?? "";
            InputAbout = profile.About ?? "";
            InputPicture = profile.Picture ?? "";
        }
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "◈";

        string trimmed = name.Trim();
        return trimmed.Length >= 2 ? trimmed[..2].ToUpperInvariant() : trimmed.ToUpperInvariant();
    }

    private void HandleImageError()
    {
        InputPicture = "";
    }

    private async Task SaveProfile()
    {
        IsSaving = true;
        StatusMessage = null;
        IsError = false;

        try
        {
            var profile = new NostrProfile(
                Name: InputDisplayName.Trim(),
                DisplayName: InputDisplayName.Trim(),
                About: string.IsNullOrWhiteSpace(InputAbout) ? null : InputAbout.Trim(),
                Picture: string.IsNullOrWhiteSpace(InputPicture) ? null : InputPicture.Trim());

            await Storage.SetProfileAsync(profile);

            // Relay publishing is off until profiles are signed with real Nostr (secp256k1) keys.
            StatusMessage = "Saved.";

            if (OnProfileSaved.HasDelegate)
            {
                await OnProfileSaved.InvokeAsync();
            }

            await Task.Delay(500);
            await Close();
        }
        catch (Exception ex)
        {
            IsError = true;
            StatusMessage = $"Error: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task Close()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }
}
