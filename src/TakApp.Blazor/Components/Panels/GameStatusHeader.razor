@using TakEngine.Abstractions
@using TakEngine.Core.Board

@if (Board != null)
{
    <div class="glass-panel" style="padding: 0.85rem 1.25rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem;">
        
        <!-- Status / Turn Info -->
        <div style="display: flex; align-items: center; gap: 1rem;">
            @if (Board.Phase == GamePhase.Completed && Board.Result != null)
            {
                var winner = Board.Result.Winner;
                string winPlayerName = winner.HasValue ? (winner.Value == PlayerColor.White ? WhitePlayerName : BlackPlayerName) : "Nobody";
                string winColorName = winner.HasValue ? winner.Value.ToString() : "Nobody";
                string reasonName = Board.Result.Reason.ToString();

                <div class="win-banner" style="padding: 0.4rem 1rem;">
                    <strong style="color: #f59e0b; font-size: 1rem;">
                        @(winner.HasValue ? $"🏆 {winPlayerName} ({winColorName}) Wins by {reasonName}!" : "🤝 Game Drawn!")
                    </strong>
                </div>
            }
            else
            {
                var activeColor = Board.ActivePlayer;
                string activePlayerName = activeColor == PlayerColor.White ? WhitePlayerName : BlackPlayerName;
                string dotClass = activeColor == PlayerColor.White ? "badge-white" : "badge-black";

                <div style="display: flex; align-items: center; gap: 0.6rem;">
                    <span class="player-badge @dotClass" style="width: 18px; height: 18px;"></span>
                    <strong style="font-size: 1.05rem;">
                        Turn @(Board.TurnNumber): @activePlayerName's Move
                    </strong>
                </div>

                @if (Board.Phase == GamePhase.FirstTurnPlacement)
                {
                    <span class="brand-badge" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; border-color: rgba(245, 158, 11, 0.3);">
                        Opening: Place Opponent's Flat Stone
                    </span>
                }
            }
        </div>

        <!-- Action Buttons -->
        <div style="display: flex; gap: 0.5rem; align-items: center;">
            @if (Board.Phase != GamePhase.Completed)
            {
                <button class="btn-tak btn-danger btn-sm" @onclick="HandleResign">
                    🏳 Resign
                </button>
            }

            <button class="btn-tak btn-ghost btn-sm" @onclick="HandleNewGame">
                ↻ Reset / Lobby
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public GameBoard? Board { get; set; }
    [Parameter] public string WhitePlayerName { get; set; } = "White";
    [Parameter] public string BlackPlayerName { get; set; } = "Black";
    [Parameter] public EventCallback OnResignRequested { get; set; }
    [Parameter] public EventCallback OnNewGameRequested { get; set; }

    private async Task HandleResign()
    {
        if (OnResignRequested.HasDelegate)
        {
            await OnResignRequested.InvokeAsync();
        }
    }

    private async Task HandleNewGame()
    {
        if (OnNewGameRequested.HasDelegate)
        {
            await OnNewGameRequested.InvokeAsync();
        }
    }
}
