@using TakEngine.Abstractions
@using TakEngine.Core.Board

@if (Board != null)
{
    <div class="play-status-bar">
        <!-- Turn Status Text -->
        <div class="play-turn-text">
            @if (Board.Phase == GamePhase.Completed && Board.Result != null)
            {
                var winner = Board.Result.Winner;
                string winPlayerName = winner.HasValue ? (winner.Value == PlayerColor.White ? WhitePlayerName : BlackPlayerName) : "Nobody";
                string reasonName = Board.Result.Reason.ToString().ToUpperInvariant();
                <span style="color: var(--accent-amber);">
                    @(winner.HasValue ? $"{winPlayerName.ToUpperInvariant()} WINS ({reasonName})" : "DRAW")
                </span>
            }
            else if (Board.Phase == GamePhase.FirstTurnPlacement)
            {
                <span>OPENING: @(Board.ActivePlayer == PlayerColor.White ? "WHITE" : "BLACK") PLACES OPPONENT</span>
            }
            else
            {
                <span>@(Board.ActivePlayer == PlayerColor.White ? "WHITE" : "BLACK") TO PLAY</span>
            }
        </div>

        <!-- Action Links: 2.5D Toggle, Resign, Leave -->
        <div class="play-actions">
            <button class="btn-perspective-toggle @(Is25D ? "active" : "")"
                    @onclick="TogglePerspective"
                    title="Toggle 2.5D / 2D Perspective View">
                @(Is25D ? "2.5D" : "2D")
            </button>

            @if (Board.Phase != GamePhase.Completed)
            {
                <button class="btn-link-action" @onclick="HandleResign">
                    Resign
                </button>
            }

            <button class="btn-link-action" @onclick="HandleLeave">
                Leave
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public GameBoard? Board { get; set; }
    [Parameter] public string WhitePlayerName { get; set; } = "White";
    [Parameter] public string BlackPlayerName { get; set; } = "Black";
    [Parameter] public bool Is25D { get; set; } = true;
    [Parameter] public EventCallback OnResignRequested { get; set; }
    [Parameter] public EventCallback OnNewGameRequested { get; set; }
    [Parameter] public EventCallback OnTogglePerspective { get; set; }

    private async Task TogglePerspective()
    {
        if (OnTogglePerspective.HasDelegate)
        {
            await OnTogglePerspective.InvokeAsync();
        }
    }

    private async Task HandleResign()
    {
        if (OnResignRequested.HasDelegate)
        {
            await OnResignRequested.InvokeAsync();
        }
    }

    private async Task HandleLeave()
    {
        if (OnNewGameRequested.HasDelegate)
        {
            await OnNewGameRequested.InvokeAsync();
        }
    }
}
