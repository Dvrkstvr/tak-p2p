@using TakEngine.Abstractions

<div class="glass-panel panel-section">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
        <span class="panel-title">Move History (PTN)</span>
        <span class="brand-badge">@(Moves.Count) moves</span>
    </div>

    <div class="move-log">
        @if (Moves.Count == 0)
        {
            <div style="color: var(--text-muted); font-size: 0.8rem; font-style: italic; padding: 0.5rem 0;">
                No moves played yet.
            </div>
        }
        else
        {
            @for (int i = 0; i < Moves.Count; i += 2)
            {
                int turnNum = (i / 2) + 1;
                string whiteMove = Moves[i];
                string? blackMove = (i + 1 < Moves.Count) ? Moves[i + 1] : null;

                <div class="move-row">
                    <span class="move-num">@(turnNum).</span>
                    <span class="move-white">@whiteMove</span>
                    <span class="move-black">@(blackMove ?? "")</span>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<string> Moves { get; set; } = new List<string>();
}
