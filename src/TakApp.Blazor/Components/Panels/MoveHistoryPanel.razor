@using TakEngine.Abstractions

<div>
    <div class="section-muted-header">MOVES</div>

    <div class="move-history-list">
        @if (Moves.Count == 0)
        {
            <div style="color: var(--text-muted); font-size: 0.85rem; font-style: italic;">
                No moves yet.
            </div>
        }
        else
        {
            @for (int i = 0; i < Moves.Count; i += 2)
            {
                int turnNum = (i / 2) + 1;
                string whiteMove = Moves[i];
                string? blackMove = (i + 1 < Moves.Count) ? Moves[i + 1] : null;

                <div class="move-history-row">
                    <span class="move-turn-num">@turnNum</span>
                    <span class="move-ptn-white">@whiteMove</span>
                    <span class="move-ptn-black">@(blackMove ?? "")</span>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<string> Moves { get; set; } = new List<string>();
}
