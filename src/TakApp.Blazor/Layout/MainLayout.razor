@inherits LayoutComponentBase
@inject BrowserStorage Storage

<div class="shell">
    <header class="topbar">
        <a href="" class="brand" aria-label="Tak home">
            <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
                <rect x="5" y="19" width="22" height="7" rx="2.5" class="bm-1" />
                <rect x="7" y="12" width="18" height="7" rx="2.5" class="bm-2" />
                <rect x="13" y="3" width="6" height="12" rx="2.5" class="bm-3" />
            </svg>
            <span class="brand-text">Tak</span>
        </a>
        <nav class="topnav">
            <NavLink href="" Match="NavLinkMatch.All">Play</NavLink>
            <NavLink href="online">Online</NavLink>
            <NavLink href="rules">Rules</NavLink>
        </nav>
        <button type="button" class="profile-chip" title="@FullNpub" @onclick="() => _profileOpen = true">
            <span class="avatar sm">@Initials</span>
            <span class="profile-chip-name">@(string.IsNullOrWhiteSpace(_nickname) ? ShortNpub : _nickname)</span>
        </button>
    </header>

    <main class="shell-main">
        @Body
    </main>

    <footer class="footer">
        <span>Tak, the game of roads · peer to peer over Nostr · every move checked on both devices</span>
        <span class="footer-links">
            <button type="button" class="link-btn" @onclick="() => _linkOpen = true">Your key and devices</button>
            <a href="https://github.com/Dvrkstvr/tak-p2p" target="_blank" rel="noopener">Source on GitHub</a>
        </span>
    </footer>
</div>

<ProfileModal IsOpen="_profileOpen" OnClose="() => _profileOpen = false" OnProfileSaved="RefreshAsync" />
<LinkDeviceModal IsOpen="_linkOpen" OnClose="() => _linkOpen = false" OnIdentityChanged="RefreshAsync" />

@code {
    private string ShortNpub { get; set; } = "";
    private string FullNpub { get; set; } = "";
    private string? _nickname;
    private bool _profileOpen;
    private bool _linkOpen;

    private string Initials => string.IsNullOrWhiteSpace(_nickname) ? "◈" : _nickname.Trim()[..Math.Min(2, _nickname.Trim().Length)].ToUpperInvariant();

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task RefreshAsync()
    {
        try
        {
            var (_, pubHex) = await Storage.GetOrCreateKeypairAsync();
            _nickname = await Storage.GetNicknameAsync();
            try
            {
                FullNpub = Nip19.ToNpub(pubHex);
                ShortNpub = $"{FullNpub[..9]}…{FullNpub[^4..]}";
            }
            catch (Exception e) when (e is ArgumentException or FormatException)
            {
                FullNpub = pubHex;
                ShortNpub = pubHex.Length > 12 ? $"{pubHex[..8]}…" : pubHex;
            }
        }
        catch (IdentityFormatException)
        {
            ShortNpub = "key unreadable";
        }
    }
}
