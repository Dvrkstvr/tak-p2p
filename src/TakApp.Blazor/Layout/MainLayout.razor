@inherits LayoutComponentBase

<div class="app-layout" style="display: flex; flex-direction: column; min-height: 100vh;">
    <!-- Top Nav Header -->
    <header class="app-header">
        <a href="" class="app-brand">
            <div class="logo-icon">◈</div>
            <span class="brand-text">TAK P2P</span>
            <span class="brand-badge">WASM</span>
        </a>

        <div style="display: flex; align-items: center; gap: 1rem;">
            <a href="https://github.com/Dvrkstvr/tak-p2p" target="_blank" class="btn-tak btn-ghost btn-sm" style="text-decoration: none;">
                ★ GitHub
