<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TakApp.Avalonia.ViewModels"
             x:Class="TakApp.Avalonia.Views.SquareView"
             x:DataType="vm:SquareViewModel">

    <Button Name="SquareButton"
            Command="{Binding SelectCommand}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Padding="0"
            Margin="2"
            Background="#3D3228"
            BorderThickness="2"
            BorderBrush="#292019"
            CornerRadius="4">

        <Panel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Background highlight for legal moves -->
            <Border Name="HighlightBorder"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    CornerRadius="3"
                    IsHitTestVisible="False"/>

            <!-- Board coordinate watermark (bottom-left) -->
            <TextBlock Text="{Binding AlgebraicCoord}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#7B6C5F"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Margin="5,0,0,3"
                       IsHitTestVisible="False"/>

            <!-- Legal Move Indicator for empty squares -->
            <Ellipse Name="LegalTargetDot"
                     Width="16"
                     Height="16"
                     Fill="#2ECC71"
                     Opacity="0.8"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False"
                     IsVisible="False"/>

            <!-- Piece Vector Container -->
            <Panel Name="PieceContainer"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Width="56"
                   Height="56"
                   IsHitTestVisible="False">

                <!-- 1. FLAT STONE (Vector Circle) -->
                <Border Name="FlatStoneShape"
                        Width="44"
                        Height="44"
                        CornerRadius="22"
                        BorderThickness="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BoxShadow="0 3 6 #50000000"
                        IsVisible="False"/>

                <!-- 2. STANDING WALL (Vector Vertical Block) -->
                <Border Name="StandingWallShape"
                        Width="16"
                        Height="42"
                        CornerRadius="3"
                        BorderThickness="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BoxShadow="0 4 8 #60000000"
                        IsVisible="False"/>

                <!-- 3. CAPSTONE (Vector Crown) -->
                <Border Name="CapstoneShape"
                        Width="38"
                        Height="38"
                        CornerRadius="19"
                        BorderThickness="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BoxShadow="0 4 10 #70000000"
                        IsVisible="False">
                    <Path Name="CapstoneCrownIcon"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Width="18"
                          Height="18"
                          Stretch="Uniform"
                          Data="M5,16L3,5L8.5,10L12,4L15.5,10L21,5L19,16H5M19,19C19,19.6 18.6,20 18,20H6C5.4,20 5,19.6 5,19V18H19V19Z"/>
                </Border>

                <!-- Tower Height Badge (when height > 1) -->
                <Border Name="StackBadge"
                        Background="#E67E22"
                        CornerRadius="9"
                        Width="18"
                        Height="18"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,0,2,0"
                        IsVisible="False">
                    <TextBlock Name="StackBadgeText"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Panel>
        </Panel>
    </Button>
</UserControl>
