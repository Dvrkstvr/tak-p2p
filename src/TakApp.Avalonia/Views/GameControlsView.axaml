<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TakApp.Avalonia.ViewModels"
             x:Class="TakApp.Avalonia.Views.GameControlsView"
             x:DataType="vm:BoardViewModel">

    <Border Background="#251E17"
            BorderBrush="#3D3227"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12"
            Margin="0,8,0,0">
        
        <StackPanel Spacing="10">
            <!-- 1. PLACEMENT PIECE SELECTOR (Shown when not in slide mode) -->
            <StackPanel IsVisible="{Binding !IsSlideMode}" Spacing="6">
                <TextBlock Text="Placement Piece Type:"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#A69482"/>

                <Grid ColumnDefinitions="*,*,*">
                    <Button Grid.Column="0"
                            Content="Flat (○)"
                            Command="{Binding SelectPieceTypeCommand}"
                            CommandParameter="Flat"
                            Margin="2,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>

                    <Button Grid.Column="1"
                            Content="Wall (▲)"
                            Command="{Binding SelectPieceTypeCommand}"
                            CommandParameter="Standing"
                            Margin="2,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>

                    <Button Grid.Column="2"
                            Content="Cap (◈)"
                            Command="{Binding SelectPieceTypeCommand}"
                            CommandParameter="Capstone"
                            Margin="2,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                </Grid>

                <TextBlock Text="Click any empty square to place the selected piece."
                           FontSize="11"
                           Foreground="#786B5E"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 2. SLIDE CONTROLS (Shown when stack is selected) -->
            <StackPanel IsVisible="{Binding IsSlideMode}" Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="Slide Stack Selected:"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#F39C12"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Content="Cancel"
                            Command="{Binding CancelSelectionCommand}"
                            Padding="8,3"
                            FontSize="11"/>
                </Grid>

                <!-- Direction selector -->
                <TextBlock Text="Direction:"
                           FontSize="11"
                           Foreground="#A69482"/>

                <Grid ColumnDefinitions="*,*,*,*" Margin="0,2">
                    <Button Grid.Column="0" Content="North (↑)" Command="{Binding SetDirectionCommand}" CommandParameter="North" Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Grid.Column="1" Content="South (↓)" Command="{Binding SetDirectionCommand}" CommandParameter="South" Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Grid.Column="2" Content="East (→)" Command="{Binding SetDirectionCommand}" CommandParameter="East" Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Grid.Column="3" Content="West (←)" Command="{Binding SetDirectionCommand}" CommandParameter="West" Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </Grid>

                <!-- Lift & Drops inputs -->
                <Grid ColumnDefinitions="Auto,*,Auto,*" Margin="0,4">
                    <TextBlock Grid.Column="0" Text="Lift:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#A69482"/>
                    <NumericUpDown Grid.Column="1" Value="{Binding SelectedLiftCount}" Minimum="1" Maximum="{Binding MaxLiftCount}" Margin="0,0,10,0"/>

                    <TextBlock Grid.Column="2" Text="Drops:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#A69482"/>
                    <TextBox Grid.Column="3" Text="{Binding SlideDropsText}"/>
                </Grid>

                <Button Content="Confirm Slide Move"
                        Command="{Binding ExecuteSlideCommand}"
                        Background="#D35400"
                        Foreground="White"
                        FontWeight="Bold"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="8"
                        Margin="0,4,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
