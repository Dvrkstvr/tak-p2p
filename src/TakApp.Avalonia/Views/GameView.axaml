<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TakApp.Avalonia.ViewModels"
             xmlns:views="using:TakApp.Avalonia.Views"
             x:Class="TakApp.Avalonia.Views.GameView"
             x:DataType="vm:GameViewModel">

    <Grid RowDefinitions="Auto,*" Margin="16">
        <!-- TOP HEADER BAR -->
        <Border Grid.Row="0"
                Background="#231B15"
                BorderBrush="#3D3025"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <!-- Status & Turn -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TurnNumber, StringFormat='Turn {0}'}"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="#F39C12"/>
                    <TextBlock Text="|"
                               Foreground="#5C4F44"
                               FontSize="16"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#E6D7C8"/>
                </StackPanel>

                <!-- Transport status badge -->
                <Border Grid.Column="2"
                        Background="#33271D"
                        CornerRadius="4"
                        Padding="8,4"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding TransportStatus}"
                               FontSize="11"
                               Foreground="#A69482"/>
                </Border>

                <!-- Header Actions -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                    <Button Content="Resign"
                            Command="{Binding ResignCommand}"
                            Background="#7B241C"
                            Foreground="White"
                            Padding="12,6"/>

                    <Button Content="New Game"
                            Command="{Binding NewGameCommand}"
                            Background="#2E4053"
                            Foreground="White"
                            Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN LAYOUT -->
        <Grid Grid.Row="1" ColumnDefinitions="*,300" Margin="0,4,0,0">
            <!-- LEFT COLUMN: Reserves, Board, and Move Controls -->
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <!-- Player Reserves -->
                    <views:PlayerReserveView DataContext="{Binding}"/>

                    <!-- Tak Board Vector View -->
                    <views:BoardView DataContext="{Binding Board}"/>

                    <!-- Placement & Slide Controls -->
                    <views:GameControlsView DataContext="{Binding Board}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT COLUMN: Move History & Game End Overlay -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <!-- Game Over Banner -->
                <Border Grid.Row="0"
                        IsVisible="{Binding IsGameOver}"
                        Background="#D35400"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="MATCH FINISHED"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding GameOverSummary}"
                                   FontSize="13"
                                   Foreground="#FDEBD0"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Move History View -->
                <views:MoveHistoryView Grid.Row="1" DataContext="{Binding}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
